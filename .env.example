# Path to an environment file containing the .NET configuration variables,
# including MercadoLibre__ClientId, MercadoLibre__ClientSecret and the exact
# HTTPS MercadoLibre__RedirectUri registered in Mercado Libre Developers.
APP_ENV_FILE=/absolute/path/to/MarketplaceSync.env

# Optional local Docker settings.
POSTGRES_PASSWORD=marketplacesync_dev
POSTGRES_PORT=5432
APP_PORT=10000
