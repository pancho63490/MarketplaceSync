@model MarketplaceSync.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth">
    <section class="auth-main">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">MS</span>
            <span class="brand-name">MarketplaceSync</span>
        </a>

        <h1 class="page-title auth-title">Crea tu cuenta</h1>
        <p class="auth-intro">Tu negocio, tus productos y tus cuentas de Mercado Libre quedan en un espacio propio.</p>

        <form asp-action="Register" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="OrganizationName" class="form-label">Nombre de tu negocio</label>
                <input asp-for="OrganizationName" class="form-control form-control-lg" placeholder="Ej. Refacciones Juárez" autocomplete="organization" autofocus />
                <span asp-validation-for="OrganizationName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="tu@correo.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" aria-describedby="password-help" />
                    <div id="password-help" class="form-text">Mínimo 6 caracteres.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label">Repite la contraseña</label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Crear cuenta</button>
        </form>

        <p class="auth-switch">¿Ya tienes cuenta? <a asp-controller="Account" asp-action="Login">Inicia sesión</a></p>
    </section>

    <partial name="_AuthAside" />
</div>
