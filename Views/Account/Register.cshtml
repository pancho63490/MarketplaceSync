@model MarketplaceSync.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-1">Crear cuenta</h2>
                    <p class="text-muted mb-4">Registra un usuario para MarketplaceSync.</p>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="OrganizationName" class="form-label"></label>
                            <input asp-for="OrganizationName" class="form-control" autocomplete="organization" />
                            <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Correo</label>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Crear cuenta
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none">
                            Ya tengo cuenta
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
