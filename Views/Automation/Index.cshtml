@model MarketplaceSync.Web.Controllers.AutomationViewModel
@using MarketplaceSync.Services.Automation
@using MarketplaceSync.Web.Models.Automation
@{
    ViewData["Title"] = "Automático";
    var s = Model.Settings;
    string Local(DateTime? utc) => utc?.AddHours(-7).ToString("dd/MM HH:mm") ?? "";
}

<header class="page-head">
    <div class="page-head-text">
        <h1 class="page-title">Automático</h1>
        <p>Lo que la app hace sola, sin que entres. Lo que gasta dinero o puede salir mal (comprar, compatibilidad, reclamos) siempre pasa por ti.</p>
    </div>
</header>

@if (!Model.AiConfigured)
{
    <div class="alert alert-warning">Las respuestas automáticas usan la IA: agrega <code>Anthropic__ApiKey</code> en Render.</div>
}

<div class="au-grid">
    <section class="panel" aria-labelledby="au-q">
        <div class="panel-head">
            <h2 id="au-q">@Html.Icon("message-circle-question") Responder preguntas fáciles</h2>
            <p>La IA contesta sola cuando la pregunta es de un tema elegido y la respuesta sale completa de los datos del producto. Si duda, te llega como siempre.</p>
        </div>
        <form asp-action="SaveQuestions" method="post" class="panel-body au-form">
            @Html.AntiForgeryToken()
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="qEnabled" name="enabled" value="true" checked="@s.AutoAnswerEnabled" />
                <input type="hidden" name="enabled" value="false" />
                <label class="form-check-label fw-bold" for="qEnabled">Responder solas</label>
            </div>
            <fieldset>
                <legend class="small fw-bold mb-1">Qué temas</legend>
                @foreach (var t in AutomationService.Topics)
                {
                    <div class="form-check au-topic @(t.CanAuto ? "" : "is-off")">
                        <input class="form-check-input" type="checkbox" id="t-@t.Id" name="topics" value="@t.Id" checked="@(t.CanAuto && Model.Topics.Contains(t.Id))" disabled="@(!t.CanAuto)" />
                        <label class="form-check-label small" for="t-@t.Id">
                            <strong>@t.Label</strong> <span class="text-muted">— «@t.Example»</span>
                            @if (!t.CanAuto) { <span class="d-block text-muted">Nunca sola: @t.WhyNot</span> }
                        </label>
                    </div>
                }
            </fieldset>
            <fieldset>
                <legend class="small fw-bold mb-1">¿Das factura?</legend>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var (val, label) in new[] { ("yes", "Sí"), ("no", "No"), ("", "No contestar sola") })
                    {
                        var on = val == "yes" ? s.OffersInvoice == true : val == "no" ? s.OffersInvoice == false : s.OffersInvoice is null;
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="invoice" id="inv-@(val == "" ? "none" : val)" value="@val" checked="@on" />
                            <label class="form-check-label small" for="inv-@(val == "" ? "none" : val)">@label</label>
                        </div>
                    }
                </div>
            </fieldset>
            <p class="small text-muted mb-0">Nunca se responde sola una pregunta que menciona año, motor o vehículo, ni las de antes de prender esto. Las que sí, te llegan a Telegram como aviso.</p>
            <button type="submit" class="btn btn-primary btn-sm align-self-start">Guardar</button>
        </form>
        <div class="panel-body au-stats">
            <span><strong>@Model.AutoAnsweredWeek</strong> respondidas solas esta semana</span>
            <span><strong>@Model.ToSellerWeek</strong> pasaron por ti</span>
            @if (Model.RecentAuto.Count > 0)
            {
                <ul class="au-recent">
                    @foreach (var q in Model.RecentAuto)
                    {
                        <li><span class="small text-muted">@Local(q.AnsweredAt) · @AutomationService.TopicLabel(q.Topic)</span><span>«@q.Text»</span><span class="small">→ @q.AnswerText</span></li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="panel" aria-labelledby="au-t">
        <div class="panel-head">
            <h2 id="au-t">@Html.Icon("message-circle") Mensaje de gracias</h2>
            <p>Cada venta pagada nueva recibe este mensaje en Mercado Libre. Le das confianza al comprador y abres el chat por si necesita algo.</p>
        </div>
        <form asp-action="SaveThanks" method="post" class="panel-body au-form">
            @Html.AntiForgeryToken()
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="tEnabled" name="enabled" value="true" checked="@s.ThankYouEnabled" />
                <input type="hidden" name="enabled" value="false" />
                <label class="form-check-label fw-bold" for="tEnabled">Mandar mensaje de gracias</label>
            </div>
            <label for="tMessage" class="form-label small mb-0">Mensaje</label>
            <textarea id="tMessage" name="message" class="form-control" rows="4" maxlength="350">@s.ThankYouMessage</textarea>
            <div class="form-text m-0"><span id="tCount">@s.ThankYouMessage.Length</span>/350 · sin teléfonos, correos ni links. Si el comprador ya te escribió, no se manda.</div>
            <button type="submit" class="btn btn-primary btn-sm align-self-start">Guardar</button>
        </form>
        <div class="panel-body au-stats">
            <span><strong>@Model.ThanksSentWeek</strong> enviados esta semana</span>
            @if (Model.ThanksFailedWeek > 0) { <span class="text-danger"><strong>@Model.ThanksFailedWeek</strong> Mercado Libre no los dejó mandar</span> }
        </div>
    </section>

    <section class="panel" aria-labelledby="au-p">
        <div class="panel-head">
            <h2 id="au-p">@Html.Icon("image") Fotos con fondo blanco</h2>
            <p>Antes de publicar un producto nuevo, el piloto automático limpia la portada: fondo blanco, producto centrado, 1200×1200. Las que tienen cosas en el fondo necesitan remove.bg.</p>
        </div>
        <form asp-action="SavePhotos" method="post" class="panel-body au-form">
            @Html.AntiForgeryToken()
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="pEnabled" name="enabled" value="true" checked="@s.FixPhotosOnPublish" />
                <input type="hidden" name="enabled" value="false" />
                <label class="form-check-label fw-bold" for="pEnabled">Poner fondo blanco al publicar</label>
            </div>
            <p class="small text-muted mb-0">Las fotos de lo que ya está publicado se arreglan en <a asp-controller="Photos" asp-action="Index">Fotos</a>.</p>
            <button type="submit" class="btn btn-primary btn-sm align-self-start">Guardar</button>
        </form>
    </section>

    <section class="panel au-wide" aria-labelledby="au-tg">
        <div class="panel-head">
            <h2 id="au-tg">@Html.Icon("send") Desde Telegram</h2>
            <p>Para no entrar a la app: escríbele al bot normal («¿cuánto vendí hoy?», «sube el faro a 3500») y confirma con un botón. Los cambios en Mercado Libre siempre esperan tu ✅, salvo los precios en automático.</p>
        </div>
        <form asp-action="SaveTelegramAutomations" method="post" class="panel-body au-form au-tg-grid">
            @Html.AntiForgeryToken()
            <fieldset>
                <legend class="fw-bold">Precios cuando cambian el dólar o tus costos</legend>
                <div class="form-check"><input class="form-check-input" type="radio" name="repricingMode" id="rpAlert" value="alert" checked="@(s.RepricingMode == RepricingModes.Alert)" /><label class="form-check-label" for="rpAlert">Avisarme con botones (Subir / Pausar / Ignorar)</label></div>
                <div class="form-check"><input class="form-check-input" type="radio" name="repricingMode" id="rpAuto" value="auto" checked="@(s.RepricingMode == RepricingModes.Auto)" /><label class="form-check-label" for="rpAuto">Subirlos solo hasta</label>
                    <input type="number" name="repricingMaxIncrease" value="@s.RepricingMaxIncreasePercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" min="1" max="100" class="form-control form-control-sm d-inline-block mx-1" style="width:70px" aria-label="Tope de subida en porcentaje" />% <span class="text-muted small">(más que eso, me pregunta)</span></div>
                <div class="form-check"><input class="form-check-input" type="radio" name="repricingMode" id="rpOff" value="off" checked="@(s.RepricingMode == RepricingModes.Off)" /><label class="form-check-label" for="rpOff">No revisar</label></div>
                <p class="small text-muted mb-0">Se revisa después de actualizar el tipo de cambio (5:00 y 12:00). Nunca baja precios. También con <code>/precios</code>.</p>
            </fieldset>
            <fieldset>
                <legend class="fw-bold">Etiquetas del día</legend>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="lbDaily" name="labelsDaily" value="true" checked="@s.LabelsDaily" />
                    <input type="hidden" name="labelsDaily" value="false" />
                    <label class="form-check-label" for="lbDaily">Mandarme el PDF y qué empacar a las</label>
                    <select name="labelsHour" class="form-select form-select-sm d-inline-block ms-1" style="width:auto;min-width:6rem" aria-label="Hora">
                        @for (var h = 5; h <= 18; h++) { <option value="@h" selected="@(s.LabelsHour == h)">@(h):00</option> }
                    </select>
                </div>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="lbThermal" name="labelsThermal" value="true" checked="@s.LabelsThermal" />
                    <input type="hidden" name="labelsThermal" value="false" />
                    <label class="form-check-label" for="lbThermal">Formato de impresora térmica</label>
                </div>
                <p class="small text-muted mb-0">Solo si hay pedidos por enviar. Cada pedido trae un botón «Empacado». También con <code>/etiquetas</code>.</p>
            </fieldset>
            <fieldset>
                <legend class="fw-bold">Compra de la semana</legend>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="wpOn" name="weeklyPurchase" value="true" checked="@s.WeeklyPurchaseEnabled" />
                    <input type="hidden" name="weeklyPurchase" value="false" />
                    <label class="form-check-label" for="wpOn">Mandarme qué recomprar cada</label>
                    <select name="weeklyPurchaseDay" class="form-select form-select-sm d-inline-block ms-1" style="width:auto;min-width:8rem" aria-label="Día">
                        @{ var days = new[] { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" }; }
                        @for (var d = 0; d < 7; d++) { <option value="@d" selected="@(s.WeeklyPurchaseDay == d)">@days[d]</option> }
                    </select>
                </div>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="wpNew" name="weeklyPurchaseIncludeNew" value="true" checked="@s.WeeklyPurchaseIncludeNew" />
                    <input type="hidden" name="weeklyPurchaseIncludeNew" value="false" />
                    <label class="form-check-label" for="wpNew">Incluir hasta 3 productos nuevos de Qué comprar</label>
                </div>
                <p class="small text-muted mb-0">Con lo vendido en 30 días y tu stock; total en dólares y links. Apruebas, y al llegar pulsas «Ya llegó todo» para sumar el stock. También con <code>/compra</code>.</p>
            </fieldset>
            <fieldset>
                <legend class="fw-bold">Campañas de Mercado Libre</legend>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="prOn" name="promotionAlerts" value="true" checked="@s.PromotionAlerts" />
                    <input type="hidden" name="promotionAlerts" value="false" />
                    <label class="form-check-label" for="prOn">Avisarme cuando me inviten a una campaña</label>
                </div>
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="adOn" name="adsAlerts" value="true" checked="@s.AdsAlerts" />
                    <input type="hidden" name="adsAlerts" value="false" />
                    <label class="form-check-label" for="adOn">Avisarme de anuncios de Mercado Ads que pierden</label>
                </div>
                <p class="small text-muted mb-0">Una vez al día. Te dice cuáles publicaciones siguen ganando con el precio de la campaña y trae un botón para meter solo esas. Nunca entra sin tu ✅. También con <code>/promos</code>.</p>
            </fieldset>
            <button type="submit" class="btn btn-primary btn-sm align-self-start">Guardar</button>
        </form>
    </section>

    <section class="panel au-next" aria-labelledby="au-n">
        <div class="panel-head"><h2 id="au-n">@Html.Icon("bot") Ya corre solo</h2></div>
        <ul class="panel-body au-list">
            <li>Buscar productos en tus categorías cada día y preparar los mejores (<a asp-controller="Agent" asp-action="Index">Agente de importación</a>).</li>
            <li>Bajar el stock al vender y mandarlo a Mercado Libre.</li>
            <li>Publicar al marcar "Recibido" una compra (con la foto en fondo blanco si está prendido arriba).</li>
            <li>Avisos a Telegram de ventas, preguntas, atrasos y reclamos.</li>
        </ul>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var t = document.getElementById('tMessage'), c = document.getElementById('tCount');
            t?.addEventListener('input', function () { c.textContent = t.value.length; });
        })();
    </script>
}
