@model MarketplaceSync.Web.Models.CrossBorder.CrossBorderSettings
@{
    ViewData["Title"] = "Costos de cruce";
    var sample = ViewBag.SampleCalculation as MarketplaceSync.Services.Interfaces.CrossBorderPricingBreakdown;
    var mx = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    string M(decimal? v, string fallback) => v.HasValue ? v.Value.ToString("C2", mx) : fallback;
}

<header class="page-head">
    <div class="page-head-text">
        <h1 class="page-title">Costos de cruce</h1>
        <p>Tus reglas para saber cuánto te cuesta cada pieza puesta en Juárez y a qué precio venderla sin perder.</p>
    </div>
</header>

<div class="cb-grid">
    <form asp-action="Save" method="post" class="cb-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="OrganizationId" />

        <section class="panel" aria-labelledby="cb-comprar">
            <div class="panel-head">
                <h2 id="cb-comprar">@Html.Icon("truck") Comprar y cruzar</h2>
                <p>Lo que pagas desde El Paso hasta tener la pieza en Juárez.</p>
            </div>
            <div class="panel-body cb-fields">
                <div>
                    <label asp-for="UsdToMxnRate" class="form-label">Tipo de cambio</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="UsdToMxnRate" class="form-control" type="number" step="0.01" min="1" placeholder="20.00" />
                        <span class="input-group-text">por dólar</span>
                    </div>
                    <span asp-validation-for="UsdToMxnRate" class="text-danger small"></span>
                    <div class="form-text">El que te cobra tu tarjeta o tu casa de cambio.</div>
                </div>
                <div>
                    <label asp-for="ImportFeePercent" class="form-label">Impuestos o comercializadora</label>
                    <div class="input-group">
                        <input asp-for="ImportFeePercent" class="form-control" type="number" step="0.5" min="0" max="100" placeholder="15" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="ImportFeePercent" class="text-danger small"></span>
                    <div class="form-text">Arancel, DTA e IVA, o la tarifa de tu comercializadora.</div>
                </div>
                <div>
                    <label asp-for="AdditionalHandlingFeeUsd" class="form-label">Manejo en El Paso</label>
                    <div class="input-group">
                        <span class="input-group-text">US$</span>
                        <input asp-for="AdditionalHandlingFeeUsd" class="form-control" type="number" step="0.25" min="0" placeholder="0.00" />
                    </div>
                    <div class="form-text">Bodega o flete del puente por pieza. Déjalo en 0 si no aplica.</div>
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="cb-vender">
            <div class="panel-head">
                <h2 id="cb-vender">@Html.Icon("store") Vender en Mercado Libre</h2>
                <p>Lo que Mercado Libre descuenta de cada venta.</p>
            </div>
            <div class="panel-body cb-fields">
                <div>
                    <label asp-for="DefaultMarketplaceFeePercent" class="form-label">Comisión</label>
                    <div class="input-group">
                        <input asp-for="DefaultMarketplaceFeePercent" class="form-control" type="number" step="0.01" min="5" max="30" placeholder="15.5" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">Premium (con meses sin intereses), la que usa la app al publicar: 15.5% en tus ventas. Varía por categoría; en Publicar se usa la real cuando Mercado Libre la da.</div>
                </div>
                <div>
                    <label asp-for="PlatformTaxWithholdingPercent" class="form-label">Retención de impuestos</label>
                    <div class="input-group">
                        <input asp-for="PlatformTaxWithholdingPercent" class="form-control" type="number" step="0.01" min="0" max="36" placeholder="31.03" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-withholding="31.03">Sin RFC · 31.03%</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-withholding="9.05">Con RFC · 9.05%</button>
                    </div>
                    <div class="form-text">Porcentaje del precio de venta. Sin RFC en Mercado Libre: 20% ISR + 16% IVA sobre el precio sin IVA. Con RFC (2026): 2.5% ISR + 8% IVA. Revísalo cada enero: la tasa de ISR la fija la Ley de Ingresos de cada año.</div>
                </div>
                <div>
                    <label asp-for="EstimatedShippingMxn" class="form-label">Envío que pagas</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="EstimatedShippingMxn" class="form-control" type="number" step="0.01" min="0" placeholder="122.50" />
                        <span class="input-group-text">MXN</span>
                    </div>
                    <div class="form-text">Promedio de la guía en ventas de $299 o más (envío gratis para el comprador).</div>
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="cb-ganar">
            <div class="panel-head">
                <h2 id="cb-ganar">@Html.Icon("badge-dollar-sign") Lo que quieres ganar</h2>
                <p>El precio sugerido cumple las dos reglas: el porcentaje y el mínimo en pesos.</p>
            </div>
            <div class="panel-body cb-fields">
                <div>
                    <label asp-for="TargetProfitMarginPercent" class="form-label">Ganancia sobre el costo</label>
                    <div class="input-group">
                        <input asp-for="TargetProfitMarginPercent" class="form-control" type="number" step="1" min="0" max="200" placeholder="25" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">Ganancia limpia sobre lo que te costó en Juárez.</div>
                </div>
                <div>
                    <label asp-for="MinProfitAmountMxn" class="form-label">Ganancia mínima por pieza</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="MinProfitAmountMxn" class="form-control" type="number" step="10" min="0" placeholder="150" />
                        <span class="input-group-text">MXN</span>
                    </div>
                    <div class="form-text">Aunque el porcentaje dé menos, nunca gana menos que esto.</div>
                </div>
                <div class="cb-switch">
                    <div class="form-check form-switch">
                        <input asp-for="AutoPublishEnabled" class="form-check-input" type="checkbox" role="switch" id="autoPublishSwitch" />
                        <label class="form-check-label" for="autoPublishSwitch">
                            <strong>Publicar solo al importar con IA</strong>
                            <span class="d-block text-muted small">Si el producto queda completo y deja tu ganancia mínima, se publica sin que lo revises.</span>
                        </label>
                    </div>
                </div>
            </div>
        </section>

        <div class="cb-save">
            <button type="submit" class="btn btn-primary">@Html.Icon("check") Guardar costos</button>
        </div>
    </form>

    <aside class="cb-sim" aria-labelledby="cb-prueba">
        <div class="panel cb-ticket">
            <div class="panel-head">
                <h2 id="cb-prueba">@Html.Icon("calculator") Prueba un precio</h2>
                <p>Escribe lo que cuesta una pieza en EE.UU. y ve el precio al que conviene venderla.</p>
            </div>
            <div class="panel-body">
                <label for="simUsdPrice" class="form-label">Precio en EE.UU.</label>
                <div class="input-group cb-sim-input">
                    <span class="input-group-text">US$</span>
                    <input type="number" id="simUsdPrice" class="form-control" value="35.00" step="1" min="1" inputmode="decimal" />
                </div>
                <div class="cb-presets" role="group" aria-label="Precios de ejemplo">
                    @foreach (var p in new[] { 15, 35, 75, 150 })
                    {
                        <button type="button" class="pub-chip" data-usd="@p">US$ @p</button>
                    }
                </div>

                <dl class="cb-lines">
                    <div><dt>Pieza en pesos</dt><dd id="simProductCostMxn">@M(sample?.ProductCostMxn, "$700.00")</dd></div>
                    <div><dt>Impuestos o comercializadora</dt><dd id="simImportTaxesMxn">+@M(sample?.ImportTaxesMxn, "$105.00")</dd></div>
                    <div class="cb-subtotal"><dt>Te cuesta en Juárez</dt><dd id="simLandedCostMxn">@M(sample?.LandedCostJuarezMxn, "$805.00")</dd></div>
                    <div><dt>Envío</dt><dd id="simShippingMxn">+@M(sample?.EstimatedShippingMxn, "$122.50")</dd></div>
                    <div><dt>Comisión (<span id="simMeliFeePct">@(sample?.MarketplaceFeePercent.ToString("0.#", mx) ?? "14.5")</span>%)</dt><dd id="simMarketplaceFeeMxn">−@M(sample?.MarketplaceFeeMxn, "$217.50")</dd></div>
                    <div><dt>Retención (<span id="simTaxPct">@(sample?.TaxWithholdingPercent.ToString("0.#", mx) ?? "9")</span>%)</dt><dd id="simTaxMxn">−@M(sample?.TaxWithholdingMxn, "$135.00")</dd></div>
                </dl>

                <div class="cb-result">
                    <div class="cb-result-label">Véndelo en</div>
                    <div class="cb-result-price" id="simSuggestedPrice">@(sample?.SuggestedListingPriceMxn.ToString("C0", mx) ?? "$1,500")</div>
                    <div class="cb-result-profit">
                        Ganas <strong id="simNetProfit">@(sample?.EffectiveNetProfitMxn.ToString("C0", mx) ?? "$300")</strong> por pieza
                        · margen <span id="simNetMargin">@(sample?.EffectiveNetMarginPercent.ToString("0.#", mx) ?? "20")%</span>
                    </div>
                </div>
                <p class="small text-muted mt-3 mb-0">Con los valores guardados. Guarda tus cambios para ver el cálculo nuevo.</p>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-withholding]').forEach(function (button) {
            button.addEventListener('click', function () {
                var field = document.getElementById('PlatformTaxWithholdingPercent');
                if (field) { field.value = button.dataset.withholding; field.dispatchEvent(new Event('change')); }
            });
        });
        (function () {
            var input = document.getElementById('simUsdPrice');
            var money = function (v, digits) { return v.toLocaleString('es-MX', { style: 'currency', currency: 'MXN', minimumFractionDigits: digits, maximumFractionDigits: digits }); };
            var set = function (id, text) { var el = document.getElementById(id); if (el) el.textContent = text; };
            var timer;

            async function run() {
                var usd = parseFloat(input.value);
                if (isNaN(usd) || usd <= 0) return;
                var body = new FormData();
                body.append('sourcePriceUsd', usd);
                try {
                    var response = await fetch('@Url.Action("Simulate", "CrossBorder")', { method: 'POST', body: body });
                    if (!response.ok) return;
                    var d = await response.json();
                    set('simProductCostMxn', money(d.productCostMxn, 2));
                    set('simImportTaxesMxn', '+' + money(d.importTaxesMxn, 2));
                    set('simLandedCostMxn', money(d.landedCostJuarezMxn, 2));
                    set('simShippingMxn', '+' + money(d.estimatedShippingMxn, 2));
                    set('simMarketplaceFeeMxn', '−' + money(d.marketplaceFeeMxn, 2));
                    set('simTaxMxn', '−' + money(d.taxWithholdingMxn, 2));
                    set('simSuggestedPrice', money(d.suggestedListingPriceMxn, 0));
                    set('simNetProfit', money(d.effectiveNetProfitMxn, 0));
                    set('simNetMargin', d.effectiveNetMarginPercent.toFixed(1) + '%');
                    set('simMeliFeePct', d.marketplaceFeePercent.toFixed(1));
                    set('simTaxPct', d.taxWithholdingPercent.toFixed(1));
                } catch (e) { console.error(e); }
            }

            input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 250); });
            document.querySelectorAll('.cb-presets [data-usd]').forEach(function (b) {
                b.addEventListener('click', function () { input.value = b.dataset.usd; run(); });
            });
        })();
    </script>
}
