@model IEnumerable<MarketplaceSync.Web.Models.Product>
@using System.Globalization

@{
    ViewData["Title"] = "Hoy";

    var mx = CultureInfo.GetCultureInfo("es-MX");
    var organizationName = ViewBag.OrganizationName as string;
    var totalProducts = (int)(ViewBag.TotalProducts ?? 0);
    var publishedProducts = (int)(ViewBag.MercadoLibreProducts ?? 0);
    var draftProducts = (int)(ViewBag.DraftProducts ?? 0);
    var reviewProducts = (int)(ViewBag.NeedsReviewProducts ?? 0);
    var readyProducts = (int)(ViewBag.ReadyProducts ?? 0);
    var connectedAccounts = (int)(ViewBag.MLConnectedAccounts ?? 0);
    var totalOrders = (int)(ViewBag.TotalOrders ?? 0);
    var ordersToday = (int)(ViewBag.OrdersToday ?? 0);
    var pendingOrders = (int)(ViewBag.PendingOrders ?? 0);
    var lowStock = (int)(ViewBag.LowStockVariants ?? 0);
    var outOfStock = (int)(ViewBag.OutOfStockVariants ?? 0);
    var radarToBuy = (int)(ViewBag.RadarToBuy ?? 0);
    var radarInTransit = (int)(ViewBag.RadarInTransit ?? 0);
    var sales30 = (decimal)(ViewBag.Sales30Days ?? 0m);
    var orders30 = (int)(ViewBag.Orders30Days ?? 0);
    var unitsInStock = (int)(ViewBag.UnitsInStock ?? 0);
    var openQuestions = (int)(ViewBag.OpenQuestions ?? 0);
    var expiringLots = (int)(ViewBag.ExpiringLots ?? 0);
    var watchedCategories = (int)(ViewBag.WatchedCategories ?? 0);
    var telegramLinked = (bool)(ViewBag.TelegramLinked ?? false);
    var salesToday = (decimal)(ViewBag.SalesToday ?? 0m);
    var salesYesterdaySoFar = (decimal)(ViewBag.SalesYesterdaySoFar ?? 0m);
    var ordersToShip = (int)(ViewBag.OrdersToShip ?? 0);
    var lateOrders = (int)(ViewBag.LateOrders ?? 0);
    var repAlerts = (ViewBag.ReputationAlerts as IReadOnlyList<MarketplaceSync.Services.Metrics.ReputationAlert>) ?? Array.Empty<MarketplaceSync.Services.Metrics.ReputationAlert>();

    // Lo que hay que hacer, en el orden en que conviene hacerlo.
    var tasks = new List<(int Count, string Title, string Detail, string Action, string Controller, string ActionName, object? Route, string Tone)>();
    var openClaims = (ViewBag.OpenClaims as List<MarketplaceSync.Web.Models.PostSale.OrderClaim>) ?? new List<MarketplaceSync.Web.Models.PostSale.OrderClaim>();
    var unansweredMessages = (int)(ViewBag.UnansweredMessages ?? 0);
    if (openClaims.Count > 0)
    {
        var firstDue = openClaims.Where(c => c.DueDate.HasValue).Select(c => c.DueDate).OrderBy(d => d).FirstOrDefault();
        tasks.Add((openClaims.Count, openClaims.Count == 1 ? "reclamo abierto" : "reclamos abiertos",
            firstDue is { } fd ? $"El más próximo vence el {fd.AddHours(-7):dd/MM HH:mm}. Responder a tiempo cuida tu reputación." : "Respóndelos para que no afecten tu reputación.",
            "Atender", "PostSale", "Index", new { tab = "claims" }, "tone-urgent"));
    }
    if (unansweredMessages > 0)
        tasks.Add((unansweredMessages, unansweredMessages == 1 ? "comprador espera tu respuesta" : "compradores esperan tu respuesta",
            "Mensajes de postventa sin contestar: dudas de envío, compatibilidad o instalación.", "Contestar", "PostSale", "Index", new { tab = "messages" }, "tone-urgent"));
    foreach (var alert in repAlerts.Where(a => a.Risk == "over"))
        tasks.Add((0, $"{alert.Metric}: {alert.RatePercent.ToString("0.##", mx)}%, arriba del límite verde ({alert.GreenLimit.ToString("0.#", mx)}%)", "Tu reputación puede bajar de color y vender menos. Revisa qué pasó y evita más casos esta semana.", "Ver reputación", "Metrics", "Index", null, "tone-urgent"));
    if (lateOrders > 0)
        tasks.Add((lateOrders, lateOrders == 1 ? "pedido atrasado por enviar" : "pedidos atrasados por enviar", "Ya pasó la hora límite: cada día de retraso cuenta como despacho con demora.", "Despachar", "Orders", "Index", new { view = "late" }, "tone-urgent"));
    if (ordersToShip - lateOrders > 0)
        tasks.Add((ordersToShip - lateOrders, ordersToShip - lateOrders == 1 ? "pedido por enviar" : "pedidos por enviar", "Imprime la etiqueta y entrégalo antes de la hora límite.", "Ver por enviar", "Orders", "Index", new { view = "toship" }, "tone-urgent"));
    if (openQuestions > 0)
        tasks.Add((openQuestions, openQuestions == 1 ? "pregunta sin responder" : "preguntas sin responder", "Contestar en menos de una hora ayuda a cerrar la venta; la IA ya dejó una respuesta lista.", "Responder", "Questions", "Index", null, "tone-urgent"));
    if (pendingOrders > 0)
        tasks.Add((pendingOrders, pendingOrders == 1 ? "pedido pendiente de pago" : "pedidos pendientes de pago", "Revísalos antes de preparar envíos.", "Ver pedidos", "Orders", "Index", null, "tone-urgent"));
    if (outOfStock > 0)
        tasks.Add((outOfStock, outOfStock == 1 ? "SKU agotado o sobrevendido" : "SKU agotados o sobrevendidos", "Pausa la publicación o resurte para no cancelar ventas.", "Ver inventario", "Inventory", "Index", new { lowStockOnly = true }, "tone-urgent"));
    if (expiringLots > 0)
        tasks.Add((expiringLots, expiringLots == 1 ? "lote por caducar" : "lotes por caducar", "Véndelos primero (baja el precio o arma un kit); lo caducado dalo de baja.", "Ver caducidades", "Inventory", "Index", null, "tone-urgent"));
    if (radarInTransit > 0)
        tasks.Add((radarInTransit, radarInTransit == 1 ? "compra en camino" : "compras en camino", "Márcalas como recibidas al llegar a Juárez para sumar el stock.", "Recibir", "Purchasing", "Index", new { tab = "transit" }, "tone-normal"));
    if (readyProducts > 0)
        tasks.Add((readyProducts, readyProducts == 1 ? "producto listo para publicar" : "productos listos para publicar", "Ya tienen sus datos; solo falta publicarlos.", "Publicar", "Products", "Index", new { stage = "Ready" }, "tone-normal"));
    if (draftProducts + reviewProducts > 0)
        tasks.Add((draftProducts + reviewProducts, draftProducts + reviewProducts == 1 ? "producto por preparar" : "productos por preparar", "Completa título, descripción y atributos con IA.", "Preparar", "Products", "Index", new { stage = draftProducts > 0 ? "Draft" : "NeedsReview" }, "tone-normal"));
    if (lowStock > 0)
        tasks.Add((lowStock, lowStock == 1 ? "SKU con stock bajo" : "SKU con stock bajo", "Agrégalos a tu próxima compra en El Paso.", "Ver qué resurtir", "Purchasing", "Index", new { tab = "restock" }, "tone-normal"));
    if (radarToBuy > 0)
        tasks.Add((radarToBuy, radarToBuy == 1 ? "producto que conviene comprar" : "productos que conviene comprar", "Tienen demanda en Mercado Libre y te dejan margen.", "Ver lista", "Purchasing", "Index", null, "tone-normal"));

    foreach (var alert in repAlerts.Where(a => a.Risk == "near"))
        tasks.Add((0, $"{alert.Metric}: {alert.RatePercent.ToString("0.##", mx)}%, cerca del límite verde ({alert.GreenLimit.ToString("0.#", mx)}%)", "Todavía estás en verde; cuida los próximos pedidos.", "Ver reputación", "Metrics", "Index", null, "tone-normal"));

    var setupSteps = new[]
    {
        (Done: connectedAccounts > 0, Title: "Conecta tu cuenta de Mercado Libre", Controller: "MercadoLibre", Action: "Status"),
        (Done: watchedCategories > 0, Title: "Elige las categorías a vigilar", Controller: "WatchedCategories", Action: "Index"),
        (Done: totalProducts > 0, Title: "Importa tu primer producto", Controller: "Products", Action: "CreateFromUrl"),
        (Done: publishedProducts > 0, Title: "Publica en Mercado Libre", Controller: "Products", Action: "Index"),
        (Done: telegramLinked, Title: "Recibe avisos en Telegram", Controller: "Notifications", Action: "Index"),
        (Done: totalOrders > 0, Title: "Recibe tu primera venta", Controller: "Orders", Action: "Index")
    };
    var setupDone = setupSteps.Count(x => x.Done);
    // Hora de Ciudad Juárez (UTC-7) para el saludo.
    var hour = DateTime.UtcNow.AddHours(-7).Hour;
    var greeting = 12 > hour ? "Buenos días" : 19 > hour ? "Buenas tardes" : "Buenas noches";
}

<div class="today">
    <header class="today-head">
        <h1 class="page-title">@greeting@(string.IsNullOrWhiteSpace(organizationName) ? "" : ", " + organizationName)</h1>
        <p class="today-summary">
            @if (tasks.Count == 0)
            {
                <span>Todo al día. Buen momento para revisar qué comprar en tu próxima visita al Paso.</span>
            }
            else
            {
                <span>Tienes @tasks.Count @(tasks.Count == 1 ? "pendiente" : "pendientes") hoy.</span>
            }
        </p>
        @if (totalOrders > 0)
        {
            var diff = salesToday - salesYesterdaySoFar;
            var daily = (ViewBag.SalesDaily as List<(DateTime Day, decimal Total)>) ?? new();
            var prev30 = (decimal)(ViewBag.SalesPrev30 ?? 0m);
            var last30 = daily.Sum(d => d.Total);
            var change30 = prev30 > 0 ? (double)((last30 - prev30) / prev30 * 100) : (double?)null;
            <div class="kpis" role="list">
                <a class="kpi" role="listitem" asp-controller="Metrics" asp-action="Index" asp-route-days="7">
                    <span class="kpi-label">@Html.Icon("circle-dollar-sign") Ventas de hoy</span>
                    <strong class="kpi-value">@salesToday.ToString("C0", mx)</strong>
                    <span class="kpi-delta @(diff > 0 ? "is-up" : diff < 0 ? "is-down" : "")">
                        @(salesYesterdaySoFar == 0 && salesToday == 0 ? "Igual que ayer a esta hora" : diff >= 0 ? $"▲ {diff.ToString("C0", mx)} vs. ayer a esta hora" : $"▼ {(-diff).ToString("C0", mx)} vs. ayer a esta hora")
                    </span>
                </a>
                <a class="kpi" role="listitem" asp-controller="Orders" asp-action="Index" asp-route-view="toship">
                    <span class="kpi-label">@Html.Icon("receipt") Pedidos de hoy</span>
                    <strong class="kpi-value">@ordersToday</strong>
                    <span class="kpi-delta @(lateOrders > 0 ? "is-down" : "")">@(ordersToShip == 0 ? "Nada por enviar" : lateOrders > 0 ? $"{ordersToShip} por enviar · {lateOrders} atrasado{(lateOrders == 1 ? "" : "s")}" : $"{ordersToShip} por enviar")</span>
                </a>
                <a class="kpi" role="listitem" asp-controller="Questions" asp-action="Index">
                    <span class="kpi-label">@Html.Icon("message-circle-question") Preguntas</span>
                    <strong class="kpi-value">@openQuestions</strong>
                    <span class="kpi-delta @(openQuestions > 0 ? "is-warn" : "is-up")">@(openQuestions == 0 ? "Todas respondidas" : "sin responder")</span>
                </a>
                <a class="kpi kpi-chart" role="listitem" asp-controller="Metrics" asp-action="Index" asp-route-days="30">
                    <span class="kpi-label">@Html.Icon("trending-up") Últimos 30 días</span>
                    <strong class="kpi-value">@last30.ToString("C0", mx)</strong>
                    <span class="kpi-delta @(change30 > 0 ? "is-up" : change30 < 0 ? "is-down" : "")">@(change30 is { } c ? (c >= 0 ? "▲ " : "▼ ") + Math.Abs(c).ToString("0", mx) + "% vs. 30 días antes" : "Sin datos del mes anterior")</span>
                    <span class="kpi-spark" id="salesSpark" aria-hidden="true"
                          data-values="@string.Join(",", daily.Select(d => d.Total.ToString("0.##", CultureInfo.InvariantCulture)))"
                          data-labels="@string.Join(",", daily.Select(d => d.Day.ToString("dd/MM")))"></span>
                </a>
            </div>
        }
    </header>

    <div class="today-grid">
        <section class="today-tasks" aria-labelledby="pendientes">
            <h2 id="pendientes" class="today-section-title">Pendientes</h2>

            @if (tasks.Count == 0)
            {
                <div class="today-clear">
                    <div class="today-clear-mark" aria-hidden="true">✓</div>
                    <div>
                        <div class="fw-bold">Sin pendientes</div>
                        <div class="text-muted small">Cuando entre un pedido o algo necesite tu atención, aparecerá aquí.</div>
                    </div>
                    <a asp-controller="Purchasing" asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">Qué comprar</a>
                </div>
            }
            else
            {
                <ol class="task-list">
                    @foreach (var task in tasks)
                    {
                        <li class="task-row @task.Tone">
                            <span class="task-count">@if (task.Count > 0) { @task.Count } else { @Html.Icon("triangle-alert") }</span>
                            <span class="task-text">
                                <span class="task-title">@task.Title</span>
                                <span class="task-detail">@task.Detail</span>
                            </span>
                            <a class="btn btn-sm @(task == tasks[0] ? "btn-primary" : "btn-outline-secondary") task-action"
                               asp-controller="@task.Controller"
                               asp-action="@task.ActionName"
                               asp-all-route-data="@(task.Route?.GetType().GetProperties().ToDictionary(p => p.Name, p => p.GetValue(task.Route)?.ToString() ?? "") ?? new Dictionary<string, string>())">@task.Action</a>
                        </li>
                    }
                </ol>
            }

            @if (setupDone < setupSteps.Length)
            {
                <h2 class="today-section-title mt-4">Para empezar</h2>
                <ol class="setup-steps">
                    @foreach (var step in setupSteps)
                    {
                        <li class="@(step.Done ? "is-done" : "")">
                            <span class="setup-check" aria-hidden="true">@(step.Done ? "✓" : "")</span>
                            @if (step.Done)
                            {
                                <span class="setup-title">@step.Title</span>
                            }
                            else
                            {
                                <a asp-controller="@step.Controller" asp-action="@step.Action" class="setup-title">@step.Title</a>
                            }
                        </li>
                    }
                </ol>
            }
        </section>

        <aside class="today-numbers" aria-labelledby="numeros">
            <h2 id="numeros" class="today-section-title">Tu negocio</h2>
            <dl class="numbers">
                <div>
                    <dt>Pedidos en 30 días</dt>
                    <dd>@orders30.ToString("N0", mx) <small>@ordersToday hoy</small></dd>
                </div>
                <div>
                    <dt>Publicados en Mercado Libre</dt>
                    <dd>@publishedProducts <small>de @totalProducts</small></dd>
                </div>
                <div>
                    <dt>Piezas en inventario</dt>
                    <dd>@unitsInStock.ToString("N0", mx)</dd>
                </div>
            </dl>
        </aside>
    </div>

    <section class="today-recent" aria-labelledby="recientes">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
            <h2 id="recientes" class="today-section-title mb-0">Productos recientes</h2>
            <a asp-controller="Products" asp-action="Index" class="small">Ver todos</a>
        </div>

        @if (!Model.Any())
        {
            <div class="today-clear">
                <div>
                    <div class="fw-bold">Tu catálogo está vacío</div>
                    <div class="text-muted small">Pega el link de un producto de eBay, Amazon o AliExpress para importarlo.</div>
                </div>
                <a asp-controller="Products" asp-action="CreateFromUrl" class="btn btn-primary btn-sm ms-auto">@Html.Icon("plus") Importar producto</a>
            </div>
        }
        else
        {
            <ul class="recent-list">
                @foreach (var item in Model.Take(6))
                {
                    var published = item.MarketplacePublications.Any(p => p.Marketplace == "MercadoLibre" && p.IsPublished);
                    <li>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="recent-item">
                            <span class="recent-thumb">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />
                                }
                            </span>
                            <span class="recent-name">@(string.IsNullOrWhiteSpace(item.Title) ? "Producto sin título" : item.Title)</span>
                            <span class="recent-meta">@(item.SourceMarketplace ?? "Manual")</span>
                            <span class="recent-state @(published ? "is-live" : "")">@(published ? "Publicado" : "Sin publicar")</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@section Scripts {
    <script src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script>
        (function () {
            var el = document.getElementById('salesSpark');
            if (!el || typeof ApexCharts === 'undefined') return;
            var values = el.dataset.values.split(',').map(Number), labels = el.dataset.labels.split(',');
            var money = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 });
            var chart = new ApexCharts(el, {
                chart: { type: 'area', height: 56, sparkline: { enabled: true }, animations: { speed: 450 } },
                series: [{ name: 'Ventas', data: values }],
                labels: labels,
                stroke: { curve: 'smooth', width: 2 },
                colors: [getComputedStyle(document.documentElement).getPropertyValue('--signal').trim()],
                fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: .32, opacityTo: 0, stops: [0, 95] } },
                tooltip: { theme: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light', x: { show: true }, y: { formatter: function (v) { return money.format(v); }, title: { formatter: function () { return ''; } } } }
            });
            chart.render();
            document.addEventListener('ms:theme', function (e) { chart.updateOptions({ tooltip: { theme: e.detail } }); });
        })();
    </script>
}
