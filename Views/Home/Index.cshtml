@model IEnumerable<MarketplaceSync.Web.Models.Product>

@{
    ViewData["Title"] = "Resumen operativo";
    var totalProducts = (int)(ViewBag.TotalProducts ?? 0);
    var mercadoLibreProducts = (int)(ViewBag.MercadoLibreProducts ?? 0);
    var draftProducts = (int)(ViewBag.DraftProducts ?? 0);
    var needsReviewProducts = (int)(ViewBag.NeedsReviewProducts ?? 0);
    var mlConnectedAccounts = (int)(ViewBag.MLConnectedAccounts ?? 0);
    var totalOrders = (int)(ViewBag.TotalOrders ?? 0);
    var ordersToday = (int)(ViewBag.OrdersToday ?? 0);
    var pendingOrders = (int)(ViewBag.PendingOrders ?? 0);
    var totalSales = (decimal)(ViewBag.TotalSales ?? 0m);
    var lowStockVariants = (int)(ViewBag.LowStockVariants ?? 0);
    var outOfStockVariants = (int)(ViewBag.OutOfStockVariants ?? 0);
    var completedSetupSteps = (mlConnectedAccounts > 0 ? 1 : 0) + (totalProducts > 0 ? 1 : 0) + (mercadoLibreProducts > 0 ? 1 : 0) + (totalOrders > 0 ? 1 : 0);
    var setupPercent = completedSetupSteps * 25;
}

<div class="dashboard-page">
    <section class="dashboard-welcome mb-4">
        <div>
            <div class="dashboard-kicker">PANEL DE CONTROL</div>
            <h2 class="dashboard-heading">Tu operación, en un solo lugar</h2>
            <p>Revisa ventas, pedidos, catálogo e inventario sin cambiar de plataforma.</p>
        </div>
        <div class="dashboard-welcome-actions">
            <a asp-controller="Orders" asp-action="Index" class="btn btn-app-light">Ver pedidos</a>
            <a asp-controller="Products" asp-action="CreateFromUrl" class="btn btn-app-primary">＋ Agregar producto</a>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Orders" asp-action="Index" class="dashboard-metric metric-blue">
                <div class="dashboard-metric-top"><span>Pedidos de hoy</span><span class="dashboard-metric-icon">≡</span></div>
                <strong>@ordersToday.ToString("N0")</strong>
                <small>@totalOrders.ToString("N0") pedidos sincronizados</small>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-metric metric-green">
                <div class="dashboard-metric-top"><span>Ventas cobradas</span><span class="dashboard-metric-icon">$</span></div>
                <strong>$@totalSales.ToString("N2")</strong>
                <small>Acumulado de Mercado Libre</small>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Products" asp-action="Index" class="dashboard-metric metric-violet">
                <div class="dashboard-metric-top"><span>Productos</span><span class="dashboard-metric-icon">□</span></div>
                <strong>@totalProducts.ToString("N0")</strong>
                <small>@mercadoLibreProducts.ToString("N0") publicados en Mercado Libre</small>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Inventory" asp-action="Index" asp-route-lowStockOnly="true" class="dashboard-metric metric-amber">
                <div class="dashboard-metric-top"><span>Alertas de inventario</span><span class="dashboard-metric-icon">!</span></div>
                <strong>@((lowStockVariants + outOfStockVariants).ToString("N0"))</strong>
                <small>@outOfStockVariants agotados o con sobreventa</small>
            </a>
        </div>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div><h3>Tareas de operación</h3><p>Elementos que requieren atención</p></div>
                    <span class="dashboard-live"><i></i> En tiempo real</span>
                </div>
                <div class="dashboard-tasks">
                    <a asp-controller="Orders" asp-action="Index" class="dashboard-task">
                        <span class="dashboard-task-icon task-blue">≡</span>
                        <span><strong>Pedidos pendientes</strong><small>Revisar estado de pago</small></span>
                        <b>@pendingOrders</b><em>›</em>
                    </a>
                    <a asp-controller="Inventory" asp-action="Index" asp-route-lowStockOnly="true" class="dashboard-task">
                        <span class="dashboard-task-icon task-amber">!</span>
                        <span><strong>Stock bajo</strong><small>Variantes bajo el mínimo</small></span>
                        <b>@lowStockVariants</b><em>›</em>
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="dashboard-task">
                        <span class="dashboard-task-icon task-violet">□</span>
                        <span><strong>Borradores</strong><small>Productos sin publicar</small></span>
                        <b>@draftProducts</b><em>›</em>
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="dashboard-task">
                        <span class="dashboard-task-icon task-red">◇</span>
                        <span><strong>Por revisar</strong><small>Precio, categoría o disponibilidad</small></span>
                        <b>@needsReviewProducts</b><em>›</em>
                    </a>
                </div>
            </section>
        </div>

        <div class="col-xl-4">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div><h3>Configuración inicial</h3><p>@completedSetupSteps de 4 pasos completados</p></div>
                    <span class="setup-score">@setupPercent%</span>
                </div>
                <div class="progress setup-progress" role="progressbar" aria-label="Progreso de configuración" aria-valuenow="@setupPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @setupPercent%"></div></div>
                <div class="setup-list">
                    <a asp-controller="MercadoLibre" asp-action="Status" class="setup-item @(mlConnectedAccounts > 0 ? "done" : "")"><span>@(mlConnectedAccounts > 0 ? "✓" : "1")</span><div><strong>Conectar una tienda</strong><small>Autoriza Mercado Libre</small></div></a>
                    <a asp-controller="Products" asp-action="CreateFromUrl" class="setup-item @(totalProducts > 0 ? "done" : "")"><span>@(totalProducts > 0 ? "✓" : "2")</span><div><strong>Agregar un producto</strong><small>Crea tu catálogo inicial</small></div></a>
                    <a asp-controller="Products" asp-action="Index" class="setup-item @(mercadoLibreProducts > 0 ? "done" : "")"><span>@(mercadoLibreProducts > 0 ? "✓" : "3")</span><div><strong>Publicar en Mercado Libre</strong><small>Activa tu primera publicación</small></div></a>
                    <a asp-controller="Orders" asp-action="Index" class="setup-item @(totalOrders > 0 ? "done" : "")"><span>@(totalOrders > 0 ? "✓" : "4")</span><div><strong>Sincronizar pedidos</strong><small>Importa tu primera venta</small></div></a>
                </div>
            </section>
        </div>
    </div>

    <section class="dashboard-panel">
        <div class="dashboard-panel-header">
            <div><h3>Productos recientes</h3><p>Últimos artículos agregados al catálogo</p></div>
            <a asp-controller="Products" asp-action="Index" class="dashboard-panel-link">Ver catálogo completo →</a>
        </div>
        @if (!Model.Any())
        {
            <div class="dashboard-empty"><span>□</span><h4>Tu catálogo está vacío</h4><p>Agrega un producto para comenzar a publicar y controlar inventario.</p><a asp-controller="Products" asp-action="CreateFromUrl" class="btn btn-app-primary">Agregar producto</a></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table dashboard-table align-middle mb-0">
                    <thead><tr><th>Producto</th><th>Origen</th><th>Precio</th><th>Stock fuente</th><th>Publicación</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var published = item.MarketplacePublications.Any(p => p.Marketplace == "MercadoLibre" && p.IsPublished);
                        <tr>
                            <td><div class="dashboard-product"><div class="dashboard-product-image">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="" /> } else { <span>□</span> }</div><div><strong>@(string.IsNullOrWhiteSpace(item.Title) ? "Sin título" : item.Title)</strong><small>@(item.Brand ?? $"Producto #{item.Id}")</small></div></div></td>
                            <td><span class="channel-badge">@(item.SourceMarketplace ?? "Manual")</span></td>
                            <td class="fw-semibold">@(item.SourcePrice?.ToString("N2") ?? "—") <small class="text-muted">@item.SourceCurrency</small></td>
                            <td><span class="stock-pill @(item.SourceStock.GetValueOrDefault() > 0 ? "in-stock" : "no-stock")">@(item.SourceStock?.ToString() ?? "N/A")</span></td>
                            <td><span class="publication-status @(published ? "published" : "draft")"><i></i> @(published ? "Publicado" : "Sin publicar")</span></td>
                            <td class="text-end"><a asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="dashboard-row-action">Administrar</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
