@model MarketplaceSync.Web.ViewModels.Inventory.InventoryIndexViewModel

@functions {
    private static string MovementLabel(string type) => type switch
    {
        "OrderSale" => "Venta",
        "OrderReversal" => "Cancelación",
        "ManualAdjustment" => "Ajuste",
        "PurchaseReceipt" => "Compra recibida",
        "ExpiredWriteOff" => "Baja por caducidad",
        _ => type
    };
}

@{
    ViewData["Title"] = "Inventario";
    var mx = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
    var today = MarketplaceSync.Services.Inventory.InventoryLotService.Today;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.LowStockOnly;
}

<header class="page-head">
    <div class="page-head-text">
        <h1 class="page-title">Inventario</h1>
        <p>Las piezas que tienes en Juárez. Cada cambio se manda solo a Mercado Libre.</p>
    </div>
</header>

<dl class="stats">
    <div class="stat"><dt>SKU activos</dt><dd>@Model.TotalVariants.ToString("N0", mx)</dd></div>
    <div class="stat"><dt>Piezas disponibles</dt><dd>@Model.TotalUnits.ToString("N0", mx)</dd></div>
    <div class="stat @(Model.LowStockVariants > 0 ? "is-warn" : "")"><dt>Stock bajo</dt><dd><a asp-action="Index" asp-route-lowStockOnly="true">@Model.LowStockVariants.ToString("N0", mx)</a></dd></div>
    <div class="stat @(Model.OutOfStockVariants > 0 ? "is-bad" : "")"><dt>Agotados o sobrevendidos</dt><dd>@Model.OutOfStockVariants.ToString("N0", mx)</dd></div>
</dl>

@if (Model.ExpiringLots.Count > 0)
{
    var expired = Model.ExpiringLots.Count(l => l.DaysLeft < 0);
    <section class="panel inv-expiry mb-4" id="caducidades" aria-labelledby="caducidades-title">
        <div class="panel-head">
            <h2 id="caducidades-title">@Html.Icon("calendar-clock") Caducidades</h2>
            <p>
                Lotes que caducan en los próximos @MarketplaceSync.Services.Inventory.InventoryLotService.WarningDays días@(expired > 0 ? $" y {expired} ya caducados" : "").
                Las ventas salen primero del lote que caduca antes. Baja el precio o arma un kit para moverlos; lo caducado dalo de baja.
            </p>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Producto</th><th>Lote</th><th>Caduca</th><th class="num">Quedan</th><th></th></tr></thead>
                <tbody>
                @foreach (var lot in Model.ExpiringLots)
                {
                    <tr>
                        <td><span class="fw-semibold">@lot.ProductTitle</span><span class="sub">@lot.Sku</span></td>
                        <td class="text-muted">@(lot.LotCode ?? "—")</td>
                        <td class="text-nowrap">
                            @lot.ExpiresOn.ToString("dd/MM/yyyy")
                            <span class="pill @(lot.DaysLeft <= 7 ? "pill-bad" : "pill-warn") ms-1">@(lot.DaysLeft < 0 ? $"Caducó hace {-lot.DaysLeft} d" : lot.DaysLeft == 0 ? "Caduca hoy" : $"En {lot.DaysLeft} d")</span>
                        </td>
                        <td class="num fw-bold">@lot.QuantityRemaining</td>
                        <td class="text-end">
                            <form asp-action="WriteOffLot" method="post" class="d-inline writeoff-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lotId" value="@lot.LotId" />
                                <button type="submit" class="btn btn-sm @(lot.DaysLeft < 0 ? "btn-danger" : "btn-outline-secondary")">Dar de baja</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

<form method="get" class="inv-filters mb-3" role="search">
    <div class="input-icon inv-search">
        @Html.Icon("search")
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="SKU, producto o código de barras" aria-label="Buscar en inventario" />
    </div>
    <div class="form-check form-switch m-0">
        <input class="form-check-input" type="checkbox" role="switch" id="lowStockOnly" name="lowStockOnly" value="true" checked="@Model.LowStockOnly" onchange="this.form.submit()" />
        <label class="form-check-label" for="lowStockOnly">Solo stock bajo</label>
    </div>
    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    @if (hasFilters)
    {
        <a asp-action="Index" class="btn btn-link px-1">Quitar filtros</a>
    }
</form>

<section class="panel mb-4" aria-labelledby="existencias">
    <div class="panel-head">
        <h2 id="existencias">Existencias por SKU</h2>
        <p>Escribe cuántas piezas tienes y pulsa Ajustar. Si las que agregas caducan, pon la fecha.</p>
    </div>
    @if (Model.Variants.Count == 0)
    {
        <div class="panel-body">
            <div class="today-clear">
                @Html.Icon("boxes", "icon-lg")
                <div>
                    <div class="fw-bold">@(hasFilters ? "Nada coincide con la búsqueda" : "Todavía no hay SKU")</div>
                    <div class="text-muted small">@(hasFilters ? "Quita los filtros para ver todo." : "Se crean al marcar una compra como recibida o al controlar una publicación desde la app.")</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table inv-table">
                <thead><tr><th>Producto</th><th class="num">Hay</th><th class="num">Vendidas</th><th>Avisar con</th><th>Ajustar existencias</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Variants)
                {
                    var variant = row.Variant;
                    var stockTone = variant.Stock <= 0 ? "pill-bad" : variant.Stock <= variant.LowStockThreshold ? "pill-warn" : "pill-ok";
                    <tr>
                        <td class="inv-product">
                            <span class="fw-semibold">@variant.Product.Title</span>
                            <span class="sub">
                                @variant.Sku
                                @if (!string.IsNullOrWhiteSpace(variant.Barcode)) { <text> · @variant.Barcode</text> }
                            </span>
                            @if (Model.NextExpiryByVariant.TryGetValue(variant.Id, out var next))
                            {
                                var days = next.ExpiresOn.DayNumber - today.DayNumber;
                                <span class="pill @(days < 0 ? "pill-bad" : days <= 30 ? "pill-warn" : "") mt-1" title="@next.LotUnits piezas con lote">Caduca @next.ExpiresOn.ToString("dd/MM/yy") · @next.Units pzs</span>
                            }
                        </td>
                        <td class="num">
                            <span class="pill @stockTone inv-stock">@variant.Stock</span>
                            @if (variant.Stock < 0) { <span class="sub text-danger">Sobreventa</span> }
                        </td>
                        <td class="num">@Math.Max(0, row.NetSoldUnits)</td>
                        <td>
                            <form asp-action="SetThreshold" method="post" class="inv-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="variantId" value="@variant.Id" />
                                <input type="number" name="lowStockThreshold" value="@variant.LowStockThreshold" min="0" max="1000000" class="form-control form-control-sm inv-num" aria-label="Avisar cuando queden estas piezas de @variant.Sku" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Guardar</button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="Adjust" method="post" class="inv-adjust">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="variantId" value="@variant.Id" />
                                <input type="number" name="newStock" value="@Math.Max(0, variant.Stock)" min="0" max="1000000" class="form-control form-control-sm inv-num" aria-label="Piezas que tienes de @variant.Sku" />
                                <input type="date" name="expiresOn" class="form-control form-control-sm inv-date" title="Caducidad de las piezas que agregas (solo si caducan)" aria-label="Caducidad de las piezas que agregas, opcional" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Ajustar</button>
                                <input type="text" name="notes" maxlength="500" class="form-control form-control-sm inv-note" placeholder="Motivo (opcional)" aria-label="Motivo del ajuste" />
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" aria-labelledby="movimientos">
    <div class="panel-head">
        <h2 id="movimientos">Movimientos recientes</h2>
        <p>Cada venta, cancelación, compra y ajuste queda registrado.</p>
    </div>
    @if (Model.RecentMovements.Count == 0)
    {
        <div class="panel-body text-muted small">Todavía no hay movimientos.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Fecha</th><th>Producto</th><th>Qué pasó</th><th>Detalle</th><th class="num">Cambio</th><th class="num">Quedaron</th></tr></thead>
                <tbody>
                @foreach (var movement in Model.RecentMovements)
                {
                    var local = movement.CreatedAt.AddHours(-7);
                    <tr>
                        <td class="text-nowrap">@local.ToString("dd/MM/yyyy")<span class="sub">@local.ToString("HH:mm")</span></td>
                        <td class="inv-move-product"><span class="fw-semibold">@movement.ProductVariant.Sku</span><span class="sub">@movement.ProductVariant.Product.Title</span></td>
                        <td><span class="pill">@MovementLabel(movement.Type)</span></td>
                        <td>@if (movement.SalesOrder is not null) { <a asp-controller="Orders" asp-action="Details" asp-route-id="@movement.SalesOrderId">Pedido #@movement.SalesOrder.ExternalOrderId</a> } else { <span class="text-muted">@(movement.Notes ?? "—")</span> }</td>
                        <td class="num fw-bold @(movement.QuantityDelta >= 0 ? "text-success" : "text-danger")">@(movement.QuantityDelta >= 0 ? "+" : "")@movement.QuantityDelta</td>
                        <td class="num fw-bold">@movement.StockAfter</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.writeoff-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var button = form.querySelector('button');
                if (button.dataset.confirmed === '1') return;
                event.preventDefault();
                button.dataset.confirmed = '1';
                button.textContent = 'Confirmar baja';
                button.classList.remove('btn-outline-secondary');
                button.classList.add('btn-danger');
                setTimeout(function () {
                    button.dataset.confirmed = '';
                    button.textContent = 'Dar de baja';
                }, 4000);
            });
        });
    </script>
}
