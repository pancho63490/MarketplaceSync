@model MarketplaceSync.Web.ViewModels.MarketInsights.MarketInsightsViewModel

@{
    ViewData["Title"] = "Más vendidos México";
}

<div class="insights-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="insights-kicker">INTELIGENCIA DE MERCADO</div>
            <h2 class="insights-title mb-1">Top 10 más vendidos en México</h2>
            <p class="text-muted mb-0">Ranking oficial de Mercado Libre para una categoría específica.</p>
        </div>
        @if (Model.Ranking is not null)
        {
            <div class="insights-updated"><span></span> Actualizado @Model.Ranking.RetrievedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        }
    </div>

    <div class="card border-0 shadow-sm insights-filter-card mb-4">
        <div class="card-body p-3 p-lg-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label asp-for="CategoryId" class="form-label insights-label">Categoría Mercado Libre México</label>
                    <input asp-for="CategoryId" class="form-control" placeholder="Ejemplo: MLM1055" />
                    <div class="form-text">Debe ser una categoría final con formato MLM seguido de números.</div>
                </div>
                <div class="col-lg-4">
                    <label asp-for="MarketplaceAccountId" class="form-label insights-label">Cuenta para consultar el ranking</label>
                    <select asp-for="MarketplaceAccountId" asp-items="Model.Accounts" class="form-select">
                        <option value="">Selecciona una cuenta</option>
                    </select>
                </div>
                <div class="col-lg-3">
                    <button type="submit" class="btn btn-primary w-100">Consultar Top 10</button>
                </div>
            </form>

            @if (Model.SavedCategories.Count > 0)
            {
                <div class="saved-categories mt-3 pt-3 border-top">
                    <span class="small text-muted fw-semibold me-2">Categorías de tu catálogo:</span>
                    @foreach (var category in Model.SavedCategories)
                    {
                        <a asp-action="Index"
                           asp-route-categoryId="@category.CategoryId"
                           asp-route-marketplaceAccountId="@Model.MarketplaceAccountId"
                           class="saved-category @(category.CategoryId == Model.CategoryId ? "active" : "")">
                            @category.CategoryId <small>@category.ProductCount</small>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.CategorySelectedAutomatically)
    {
        <div class="alert alert-primary border-0 shadow-sm">
            Se seleccionó automáticamente <strong>@Model.CategoryId</strong>, la categoría más usada en tus publicaciones.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@Model.ErrorMessage</span>
            @if (Model.Accounts.Count == 0)
            {
                <a asp-controller="MercadoLibre" asp-action="Status" class="btn btn-sm btn-outline-dark">Conectar cuenta</a>
            }
        </div>
    }

    @if (TempData["Error"] is string actionError)
    {
        <div class="alert alert-danger border-0 shadow-sm">@actionError</div>
    }

    @if (Model.Ranking is not null)
    {
        var analysis = Model.OpportunityAnalysis;
        var bestOpportunity = analysis?.Opportunities.FirstOrDefault();
        var unavailableDetails = Model.Ranking.Items.Count(x => !x.DetailsAvailable);

        @if (analysis is not null)
        {
            <div class="opportunity-summary mb-4">
                <div class="opportunity-summary-card featured">
                    <span>Mejor oportunidad</span>
                    <strong>@(bestOpportunity?.Score ?? 0)<small>/100</small></strong>
                    <p>@(bestOpportunity?.Item.Name ?? "Sin resultados")</p>
                </div>
                <div class="opportunity-summary-card">
                    <span>Precio mediano Top 10</span>
                    <strong>@(analysis.MedianPrice.HasValue ? $"${analysis.MedianPrice.Value:N2}" : "N/D")</strong>
                    <p>Referencia para comparar precios</p>
                </div>
                <div class="opportunity-summary-card">
                    <span>Publicaciones activas</span>
                    <strong>@(analysis.TotalActiveListings?.ToString("N0") ?? "N/D")</strong>
                    <p>En la categoría seleccionada</p>
                </div>
                <div class="opportunity-summary-card">
                    <span>Competencia estimada</span>
                    <strong>@analysis.CategoryCompetitionLevel</strong>
                    <p>Según publicaciones activas de la categoría</p>
                </div>
            </div>
        }

        @if (unavailableDetails > 0)
        {
            <div class="alert alert-warning border-0 shadow-sm small">
                Mercado Libre no expuso la ficha pública de <strong>@unavailableDetails</strong> User Product(s) de otros vendedores. Intentamos relacionarlos con el catálogo oficial; los que sigan como “Ficha no disponible” no se pueden preparar para publicar de forma segura.
            </div>
        }

        <div class="card border-0 shadow-sm insights-ranking-card">
            <div class="card-header bg-white border-0 px-3 px-lg-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="h6 fw-bold mb-1">@Model.Ranking.CategoryName</h3>
                    <div class="small text-muted">@Model.Ranking.CategoryId · Ranking BEST_SELLER</div>
                </div>
                <div class="ranking-count">Ordenado por oportunidad</div>
            </div>

            @if (analysis is null || analysis.Opportunities.Count == 0)
            {
                <div class="text-center py-5 text-muted">Esta categoría no tiene productos clasificados en el ranking.</div>
            }
            else
            {
                <div class="best-seller-grid">
                    @foreach (var opportunity in analysis.Opportunities)
                    {
                        var item = opportunity.Item;
                        <article class="best-seller-card">
                            <div class="best-seller-position @(item.Position <= 3 ? $"position-{item.Position}" : "")">#@item.Position</div>
                            <div class="best-seller-image">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span>□</span>
                                }
                            </div>
                            <div class="best-seller-content">
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    <span class="best-seller-type">@item.Type.Replace('_', ' ')</span>
                                    <span class="opportunity-level level-@opportunity.Level.ToLowerInvariant()">@opportunity.Level</span>
                                </div>
                                <h4>@item.Name</h4>
                                <div class="best-seller-id">
                                    @item.Id
                                    @if (!string.IsNullOrWhiteSpace(item.Brand))
                                    {
                                        <span> · @item.Brand</span>
                                    }
                                    @if (opportunity.AlreadyInCatalog)
                                    {
                                        <span class="catalog-badge">Ya está en tu catálogo</span>
                                    }
                                </div>
                                <div class="opportunity-score-row">
                                    <strong>@opportunity.Score<small>/100</small></strong>
                                    <div class="opportunity-score-track"><span style="width: @opportunity.Score%"></span></div>
                                </div>
                                <div class="opportunity-components">
                                    <span>Demanda <strong>@opportunity.DemandScore</strong></span>
                                    <span>Precio <strong>@opportunity.PriceScore</strong></span>
                                    <span>Competencia <strong>@opportunity.CompetitionScore</strong></span>
                                </div>
                                <p class="opportunity-recommendation">@opportunity.Recommendation</p>
                                @if (item.DetailsAvailable)
                                {
                                    <form asp-action="PrepareForPublishing" method="post" class="mb-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryId" value="@Model.Ranking.CategoryId" />
                                        <input type="hidden" name="marketplaceAccountId" value="@Model.MarketplaceAccountId" />
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary w-100 opportunity-publish-button">
                                            Preparar para publicar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="unavailable-product-note mb-2">Ficha privada de otro vendedor</div>
                                }
                                <div class="d-flex justify-content-between align-items-end gap-2 mt-auto">
                                    <div class="best-seller-price">
                                        @if (item.Price.HasValue)
                                        {
                                            <strong>$@item.Price.Value.ToString("N2")</strong><small>@item.CurrencyId</small>
                                        }
                                        else
                                        {
                                            <span>Precio no disponible</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Permalink))
                                    {
                                        <a href="@item.Permalink" target="_blank" rel="noopener" class="best-seller-link">Ver ↗</a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="insights-note mt-3">
            La puntuación combina demanda por posición (50%), precio frente a la mediana (25%) y competencia estimada por cantidad de publicaciones y presencia de marca (25%). Mercado Libre no expone unidades vendidas ni competencia exacta; úsala como señal para investigar proveedor y margen.
        </div>
    }

    @if (Model.History is { SnapshotCount: > 0 } history)
    {
        var chartJson = System.Text.Json.JsonSerializer.Serialize(
            history.Series.Select(series => new
            {
                name = series.Name,
                points = series.Points.Select(point => new
                {
                    date = point.Date.ToString("yyyy-MM-dd"),
                    position = point.Position
                })
            }));

        <section class="ranking-history mt-4">
            <div class="card border-0 shadow-sm history-card">
                <div class="card-header bg-white border-0 px-3 px-lg-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="insights-kicker">TENDENCIAS</div>
                        <h3 class="h5 fw-bold mb-1">Historial del ranking</h3>
                        <div class="small text-muted">
                            @history.SnapshotCount captura(s) · Última @history.LatestCapturedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <div class="history-periods">
                        @foreach (var period in new[] { 7, 30, 90 })
                        {
                            <a asp-action="Index"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-marketplaceAccountId="@Model.MarketplaceAccountId"
                               asp-route-days="@period"
                               class="@(history.Days == period ? "active" : "")">@period días</a>
                        }
                    </div>
                </div>

                @if (history.SnapshotCount == 1)
                {
                    <div class="history-first-capture mx-3 mx-lg-4 mb-4">
                        Captura inicial guardada. Mañana aparecerán movimientos, entradas, salidas y cambios de precio.
                    </div>
                }
                else if (history.Series.Count > 0)
                {
                    <div class="history-chart-wrap px-3 px-lg-4 pb-4">
                        <canvas id="ranking-history-chart" height="230" aria-label="Evolución de posiciones del Top 5"></canvas>
                        <div id="ranking-history-legend" class="history-chart-legend"></div>
                    </div>
                }

                <div class="history-trends">
                    @foreach (var trend in history.Trends)
                    {
                        var priceChange = trend.CurrentPrice.HasValue && trend.PreviousPrice.HasValue
                            ? trend.CurrentPrice.Value - trend.PreviousPrice.Value
                            : (decimal?)null;
                        <article class="history-trend-row @(trend.HasExited ? "exited" : "")">
                            <div class="history-trend-image">
                                @if (!string.IsNullOrWhiteSpace(trend.ImageUrl))
                                {
                                    <img src="@trend.ImageUrl" alt="@trend.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span>□</span>
                                }
                            </div>
                            <div class="history-trend-main">
                                <strong>@trend.Name</strong>
                                <small>@trend.ExternalId</small>
                            </div>
                            <div class="history-trend-position">
                                @if (trend.IsNew)
                                {
                                    <span class="trend-badge new">Nuevo #@trend.CurrentPosition</span>
                                }
                                else if (trend.HasExited)
                                {
                                    <span class="trend-badge exited">Salió del Top 10</span>
                                }
                                else if (trend.PositionChange > 0)
                                {
                                    <span class="trend-badge up">↑ @trend.PositionChange · #@trend.CurrentPosition</span>
                                }
                                else if (trend.PositionChange < 0)
                                {
                                    <span class="trend-badge down">↓ @Math.Abs(trend.PositionChange.Value) · #@trend.CurrentPosition</span>
                                }
                                else
                                {
                                    <span class="trend-badge same">Sin cambio · #@trend.CurrentPosition</span>
                                }
                            </div>
                            <div class="history-trend-price">
                                @if (trend.CurrentPrice.HasValue)
                                {
                                    <strong>$@trend.CurrentPrice.Value.ToString("N2")</strong>
                                    @if (priceChange.HasValue && priceChange.Value != 0)
                                    {
                                        <small class="@(priceChange > 0 ? "price-up" : "price-down")">
                                            @(priceChange > 0 ? "+" : "")@priceChange.Value.ToString("N2")
                                        </small>
                                    }
                                }
                                else
                                {
                                    <span>Precio N/D</span>
                                }
                            </div>
                            <div class="history-trend-score">
                                @if (trend.OpportunityScore.HasValue)
                                {
                                    <strong>@trend.OpportunityScore</strong><small>/100</small>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        @if (history.SnapshotCount > 1 && history.Series.Count > 0)
        {
            <script>
                (function () {
                    var series = @Html.Raw(chartJson);
                    var canvas = document.getElementById('ranking-history-chart');
                    if (!canvas || !series.length) return;
                    var colors = ['#246bfd', '#20a36a', '#f59e0b', '#8b5cf6', '#ef5b67'];
                    var context = canvas.getContext('2d');
                    var ratio = window.devicePixelRatio || 1;
                    var width = canvas.clientWidth || 900;
                    var height = 230;
                    canvas.width = width * ratio;
                    canvas.height = height * ratio;
                    context.scale(ratio, ratio);
                    var padding = { left: 34, right: 16, top: 14, bottom: 28 };
                    var plotWidth = width - padding.left - padding.right;
                    var plotHeight = height - padding.top - padding.bottom;
                    var dates = series[0].points.map(function (point) { return point.date; });

                    context.font = '10px system-ui';
                    context.strokeStyle = '#e8ecf2';
                    context.fillStyle = '#8792a3';
                    context.lineWidth = 1;
                    [1, 3, 5, 7, 10].forEach(function (position) {
                        var y = padding.top + ((position - 1) / 9) * plotHeight;
                        context.beginPath(); context.moveTo(padding.left, y); context.lineTo(width - padding.right, y); context.stroke();
                        context.fillText('#' + position, 8, y + 3);
                    });

                    series.forEach(function (item, index) {
                        context.strokeStyle = colors[index % colors.length];
                        context.fillStyle = colors[index % colors.length];
                        context.lineWidth = 2;
                        context.beginPath();
                        var drawing = false;
                        item.points.forEach(function (point, pointIndex) {
                            if (point.position == null) { drawing = false; return; }
                            var x = padding.left + (dates.length <= 1 ? plotWidth / 2 : pointIndex / (dates.length - 1) * plotWidth);
                            var y = padding.top + ((point.position - 1) / 9) * plotHeight;
                            if (!drawing) { context.moveTo(x, y); drawing = true; } else { context.lineTo(x, y); }
                        });
                        context.stroke();
                        item.points.forEach(function (point, pointIndex) {
                            if (point.position == null) return;
                            var x = padding.left + (dates.length <= 1 ? plotWidth / 2 : pointIndex / (dates.length - 1) * plotWidth);
                            var y = padding.top + ((point.position - 1) / 9) * plotHeight;
                            context.beginPath(); context.arc(x, y, 3, 0, Math.PI * 2); context.fill();
                        });
                    });

                    if (dates.length) {
                        context.fillStyle = '#8792a3';
                        context.fillText(dates[0].slice(5), padding.left, height - 8);
                        if (dates.length > 1) context.fillText(dates[dates.length - 1].slice(5), width - padding.right - 32, height - 8);
                    }
                    document.getElementById('ranking-history-legend').innerHTML = series.map(function (item, index) {
                        return '<span><i style="background:' + colors[index % colors.length] + '"></i>' +
                            item.name.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</span>';
                    }).join('');
                })();
            </script>
        }
    }
</div>

<style>
    .insights-kicker { color: #246bfd; font-size: .67rem; font-weight: 850; letter-spacing: .12em; margin-bottom: .35rem; }
    .insights-title { color: #172033; font-size: 1.65rem; font-weight: 850; letter-spacing: -.035em; }
    .insights-updated { background: #e8f8f0; border-radius: 999px; color: #168759; font-size: .7rem; font-weight: 750; padding: .45rem .75rem; }
    .insights-updated span { background: #1bae6f; border-radius: 50%; display: inline-block; height: 7px; margin-right: 5px; width: 7px; }
    .insights-filter-card, .insights-ranking-card { border-radius: 16px; overflow: hidden; }
    .insights-label { color: #526075; font-size: .73rem; font-weight: 750; }
    .saved-category { background: #f3f5f8; border: 1px solid #e2e7ee; border-radius: 999px; color: #59677c; display: inline-flex; font-size: .68rem; font-weight: 750; gap: 5px; margin: 3px; padding: .35rem .58rem; text-decoration: none; }
    .saved-category small { align-items: center; background: #fff; border-radius: 50%; display: inline-flex; font-size: .58rem; height: 17px; justify-content: center; width: 17px; }
    .saved-category.active, .saved-category:hover { background: #edf4ff; border-color: #8ab2ff; color: #1857d8; }
    .ranking-count { background: #f2f5f8; border-radius: 999px; color: #68758a; font-size: .67rem; font-weight: 750; padding: .4rem .65rem; }
    .opportunity-summary { display: grid; gap: 12px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .opportunity-summary-card { background: #fff; border: 1px solid #e9edf3; border-radius: 14px; box-shadow: 0 5px 18px rgba(19, 36, 67, .05); min-width: 0; padding: 16px; }
    .opportunity-summary-card.featured { background: linear-gradient(135deg, #1857d8, #347cfa); border-color: transparent; color: #fff; }
    .opportunity-summary-card span { color: #8a96a8; display: block; font-size: .62rem; font-weight: 800; letter-spacing: .04em; margin-bottom: 7px; text-transform: uppercase; }
    .opportunity-summary-card strong { color: #172033; display: block; font-size: 1.2rem; font-weight: 850; line-height: 1.1; }
    .opportunity-summary-card strong small { font-size: .62rem; opacity: .7; }
    .opportunity-summary-card p { color: #8792a3; font-size: .63rem; line-height: 1.35; margin: 6px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .opportunity-summary-card.featured span, .opportunity-summary-card.featured p { color: rgba(255,255,255,.75); }
    .opportunity-summary-card.featured strong { color: #fff; }
    .best-seller-grid { display: grid; gap: 1px; grid-template-columns: repeat(2, minmax(0, 1fr)); background: #edf0f4; border-top: 1px solid #edf0f4; }
    .best-seller-card { background: #fff; display: grid; gap: 14px; grid-template-columns: 34px 94px minmax(0, 1fr); min-height: 235px; padding: 17px; position: relative; }
    .best-seller-position { align-items: center; align-self: start; background: #f0f3f7; border-radius: 9px; color: #6d798c; display: inline-flex; font-size: .72rem; font-weight: 900; height: 32px; justify-content: center; width: 32px; }
    .best-seller-position.position-1 { background: #fff2bf; color: #a66b00; } .best-seller-position.position-2 { background: #edf0f4; color: #68758a; } .best-seller-position.position-3 { background: #f8e6d8; color: #a65f31; }
    .best-seller-image { align-items: center; background: #f7f8fa; border: 1px solid #edf0f4; border-radius: 11px; display: flex; height: 100px; justify-content: center; overflow: hidden; width: 94px; }
    .best-seller-image img { height: 100%; object-fit: contain; width: 100%; } .best-seller-image span { color: #9aa4b3; font-size: 1.4rem; }
    .best-seller-content { display: flex; flex-direction: column; min-width: 0; }
    .best-seller-type { color: #246bfd; font-size: .57rem; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; }
    .best-seller-content h4 { color: #344054; display: -webkit-box; font-size: .78rem; font-weight: 780; line-height: 1.4; margin: 5px 0 2px; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .best-seller-id { color: #9aa4b3; font-family: ui-monospace, monospace; font-size: .58rem; }
    .catalog-badge { background: #e8f8f0; border-radius: 999px; color: #168759; display: inline-block; font-family: inherit; font-weight: 750; margin-left: 5px; padding: 2px 6px; }
    .opportunity-level { border-radius: 999px; font-size: .56rem; font-weight: 850; padding: 3px 7px; text-transform: uppercase; }
    .opportunity-level.level-alta { background: #e5f8ef; color: #128457; } .opportunity-level.level-buena { background: #eaf2ff; color: #1857d8; } .opportunity-level.level-media { background: #fff5d9; color: #9a6b00; } .opportunity-level.level-baja { background: #f3f4f6; color: #6b7280; }
    .opportunity-level.level-limitada { background: #f3f4f6; color: #7b8493; }
    .opportunity-score-row { align-items: center; display: grid; gap: 8px; grid-template-columns: 44px 1fr; margin-top: 9px; }
    .opportunity-score-row > strong { color: #172033; font-size: .86rem; font-weight: 900; } .opportunity-score-row small { color: #9aa4b3; font-size: .52rem; }
    .opportunity-score-track { background: #edf0f4; border-radius: 999px; height: 6px; overflow: hidden; } .opportunity-score-track span { background: linear-gradient(90deg, #246bfd, #27b27b); border-radius: inherit; display: block; height: 100%; }
    .opportunity-components { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 7px; } .opportunity-components span { background: #f5f7fa; border-radius: 6px; color: #8490a2; font-size: .55rem; padding: 3px 5px; } .opportunity-components strong { color: #526075; }
    .opportunity-recommendation { color: #68758a; font-size: .61rem; line-height: 1.35; margin: 7px 0; }
    .opportunity-publish-button { border-radius: 8px; font-size: .66rem; font-weight: 800; padding: .42rem .65rem; }
    .unavailable-product-note { background: #f3f4f6; border-radius: 8px; color: #7b8493; font-size: .62rem; font-weight: 750; padding: .48rem .65rem; text-align: center; }
    .best-seller-price strong, .best-seller-price small { display: block; } .best-seller-price strong { color: #172033; font-size: .86rem; } .best-seller-price small, .best-seller-price span { color: #9aa4b3; font-size: .6rem; }
    .best-seller-link { color: #246bfd; font-size: .67rem; font-weight: 750; text-decoration: none; }
    .insights-note { color: #7b8798; font-size: .68rem; line-height: 1.5; text-align: center; }
    .history-card { border-radius: 16px; overflow: hidden; }
    .history-periods { background: #f2f5f8; border-radius: 10px; display: flex; gap: 3px; padding: 3px; }
