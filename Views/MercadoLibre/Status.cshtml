@model IReadOnlyList<MarketplaceSync.Web.Models.Marketplace.MarketplaceAccountStatusViewModel>

@{
    ViewData["Title"] = "Cuentas de Mercado Libre";
    var accounts = Model ?? Array.Empty<MarketplaceSync.Web.Models.Marketplace.MarketplaceAccountStatusViewModel>();
    var connected = accounts.Where(x => x.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase)).ToList();
}

<header class="page-head">
    <div class="page-head-text">
        <h1 class="page-title">Cuentas de Mercado Libre</h1>
        <p>La app usa tu cuenta para leer pedidos, preguntas y más vendidos, y para publicar. El acceso se renueva solo.</p>
    </div>
    <div class="page-head-actions">
        <a asp-action="Connect" class="btn @(connected.Count == 0 ? "btn-primary" : "btn-outline-secondary")">@Html.Icon("link") @(connected.Count == 0 ? "Conectar mi cuenta" : "Conectar otra cuenta")</a>
    </div>
</header>

@if (accounts.Count == 0)
{
    <div class="today-clear">
        @Html.Icon("link", "icon-lg")
        <div>
            <div class="fw-bold">Todavía no conectas tu cuenta</div>
            <div class="text-muted small">Te llevamos a Mercado Libre para que autorices la app. No vemos ni guardamos tu contraseña.</div>
        </div>
        <a asp-action="Connect" class="btn btn-primary btn-sm ms-auto">Conectar</a>
    </div>
}
else
{
    <ul class="acc-list">
        @foreach (var account in accounts)
        {
            var isConnected = account.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase);
            var (label, tone) = isConnected
                ? account.HasActiveToken ? ("Conectada", "pill-ok") : ("Vuelve a conectarla", "pill-warn")
                : ("Desconectada", "");
            <li class="acc-item panel">
                <span class="acc-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(account.DisplayName) ? "ML" : account.DisplayName[..1].ToUpperInvariant())</span>
                <div class="acc-main">
                    <div class="acc-name">@account.DisplayName <span class="pill @tone ms-1">@label</span></div>
                    <div class="acc-meta">ID @account.ExternalAccountId · conectada el @account.ConnectedAt.AddHours(-7).ToString("dd/MM/yyyy")</div>
                    @if (isConnected && !account.HasActiveToken)
                    {
                        <div class="small text-warning mt-1">Mercado Libre retiró el permiso. Pulsa “Conectar otra cuenta” y entra con esta misma cuenta.</div>
                    }
                </div>
                @if (isConnected)
                {
                    <form asp-action="DisconnectAccount" method="post" class="disconnect-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accountId" value="@account.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Desconectar</button>
                    </form>
                }
            </li>
        }
    </ul>
    <p class="small text-muted mt-3">Por seguridad, la app nunca muestra las llaves de acceso de tu cuenta.</p>
}

@section Scripts {
    <script>
        document.querySelectorAll('.disconnect-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var button = form.querySelector('button');
                if (button.dataset.confirmed === '1') return;
                event.preventDefault();
                button.dataset.confirmed = '1';
                button.textContent = 'Confirmar: desconectar';
                button.classList.replace('btn-outline-danger', 'btn-danger');
                setTimeout(function () {
                    button.dataset.confirmed = '';
                    button.textContent = 'Desconectar';
                    button.classList.replace('btn-danger', 'btn-outline-danger');
                }, 4000);
            });
        });
    </script>
}
