@model IReadOnlyList<MarketplaceSync.Web.Models.Marketplace.MarketplaceAccountStatusViewModel>
@{ Context.Items["FlashRendered"] = true; }

@{
    ViewData["Title"] = "Cuentas de Mercado Libre";
    var accounts = Model ?? Array.Empty<MarketplaceSync.Web.Models.Marketplace.MarketplaceAccountStatusViewModel>();
    var connectedCount = accounts.Count(x =>
        x.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase) && x.HasActiveToken);
    var expiredCount = accounts.Count(x =>
        x.HasActiveToken && x.TokenExpiresAt.HasValue && x.TokenExpiresAt.Value <= DateTime.UtcNow);
}

<div class="container-fluid px-4 py-4">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Cuentas de Mercado Libre</h1>
            <p class="text-muted mb-0">Estado de conexión para la organización actual.</p>
        </div>
        <a asp-action="Connect" class="btn btn-success">Conectar cuenta</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">Cuentas registradas</div>
                <div class="fs-3 fw-bold">@accounts.Count</div>
            </div></div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">Conectadas</div>
                <div class="fs-3 fw-bold text-success">@connectedCount</div>
            </div></div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">Con token vencido</div>
                <div class="fs-3 fw-bold @(expiredCount > 0 ? "text-danger" : "")">@expiredCount</div>
            </div></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        @if (accounts.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h2 class="h5 fw-bold">Aún no hay cuentas conectadas</h2>
                <p class="text-muted">Conecta tu cuenta para publicar y sincronizar productos.</p>
                <a asp-action="Connect" class="btn btn-success">Conectar Mercado Libre</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cuenta</th>
                            <th>ID de Mercado Libre</th>
                            <th>Estado</th>
                            <th>Token</th>
                            <th>Vencimiento</th>
                            <th>Conectada</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var account in accounts)
                    {
                        var isConnected = account.Status.Equals("Connected", StringComparison.OrdinalIgnoreCase);
                        var tokenExpired = account.TokenExpiresAt.HasValue && account.TokenExpiresAt.Value <= DateTime.UtcNow;
                        <tr>
                            <td class="fw-semibold">@account.DisplayName</td>
                            <td><code>@account.ExternalAccountId</code></td>
                            <td>
                                @if (isConnected && account.HasActiveToken && !tokenExpired)
                                {
                                    <span class="badge text-bg-success">Conectada</span>
                                }
                                else if (isConnected && tokenExpired)
                                {
                                    <span class="badge text-bg-warning">Token vencido</span>
                                }
                                else if (isConnected)
                                {
                                    <span class="badge text-bg-warning">Sin token activo</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Desconectada</span>
                                }
                            </td>
                            <td>@(account.HasActiveToken ? "Activo" : "Inactivo")</td>
                            <td>
                                @if (account.TokenExpiresAt.HasValue)
                                {
                                    @account.TokenExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@account.ConnectedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                @if (isConnected)
                                {
                                    <form asp-action="DisconnectAccount" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Desconectar esta cuenta de Mercado Libre?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="accountId" value="@account.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desconectar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="card-footer bg-white text-muted small">
            Por seguridad, esta pantalla nunca muestra access tokens ni refresh tokens.
        </div>
    </div>
</div>
