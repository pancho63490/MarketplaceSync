@model MarketplaceSync.Web.ViewModels.Orders.OrderDetailsViewModel
@using System.Globalization
@using MarketplaceSync.Services.PostSale

@{
    var o = Model.Order;
    ViewData["Title"] = $"Pedido #{o.ExternalOrderId}";
    var mx = CultureInfo.GetCultureInfo("es-MX");
    string Local(DateTime utc, string format = "dd/MM/yyyy HH:mm") => utc.AddHours(-7).ToString(format);
    var (statusLabel, statusTone) = o.Status switch
    {
        "paid" => ("Pagado", "pill-ok"),
        "cancelled" => ("Cancelado", "pill-bad"),
        "partially_refunded" => ("Reembolso parcial", "pill-warn"),
        "payment_required" or "payment_in_process" => ("Pago pendiente", "pill-warn"),
        _ => (o.Status.Replace('_', ' '), "")
    };
    var shipLabel = o.ShippingLogistic == "fulfillment" ? "Full: lo envía Mercado Libre"
        : (o.ShippingStatus, o.ShippingSubstatus) switch
        {
            ("ready_to_ship", "ready_to_print") => "Imprime la etiqueta",
            ("ready_to_ship", "printed") => "Etiqueta impresa: entrégalo",
            ("ready_to_ship", _) => "Listo para enviar",
            ("handling" or "pending", _) => "Por preparar",
            ("shipped", _) => "En camino",
            ("delivered", _) => "Entregado",
            ("not_delivered", _) => "No entregado",
            ("cancelled", _) => "Envío cancelado",
            _ => o.ShippingId is null ? "Sin envío de Mercado Libre" : "Sin dato todavía"
        };
    var late = o.NeedsShipping && o.ShippingDeadline < DateTime.UtcNow;
    var draft = TempData["DraftMessage"] as string;
    var lastFromBuyer = Model.Messages.Count > 0 && !Model.Messages[^1].FromSeller;
    var openClaims = Model.Claims.Where(c => c.IsOpen).ToList();
}

<header class="page-head">
    <div class="page-head-text">
        <a asp-action="Index" class="pe-back">← Pedidos</a>
        <h1 class="page-title">Pedido #@o.ExternalOrderId</h1>
        <span class="page-head-meta">
            <span class="pill @statusTone">@statusLabel</span>
            <span class="pill @(late ? "pill-bad" : o.NeedsShipping ? "pill-warn" : "pill-info") ms-1">@(late ? "Atrasado: despáchalo ya" : shipLabel)</span>
            · @Local(o.DateCreated) · @(o.MarketplaceAccount.DisplayName ?? o.MarketplaceAccount.ExternalAccountId)
        </span>
    </div>
    <div class="od-total">
        <span>Total</span>
        <strong>@o.TotalAmount.ToString("C0", mx)</strong>
    </div>
</header>

@if (openClaims.Count > 0)
{
    foreach (var c in openClaims)
    {
        <a asp-controller="PostSale" asp-action="Claim" asp-route-id="@c.Id" class="od-claim-alert">
            @Html.Icon("triangle-alert")
            <span>
                <strong>@(c.Stage == "dispute" ? "Disputa abierta" : "Reclamo abierto"): @c.ReasonLabel</strong>
                <span class="d-block small">@(c.DueDate is { } due ? $"Responde antes del {Local(due, "dd/MM HH:mm")} para no afectar tu reputación." : "Revisa qué pide el comprador.")</span>
            </span>
            <span class="ms-auto fw-bold">Atender @Html.Icon("chevron-right", "icon-xs")</span>
        </a>
    }
}

<div class="od-grid">
    <div class="od-main">
        <section class="panel" id="conversacion" aria-labelledby="od-chat">
            <div class="panel-head">
                <h2 id="od-chat">@Html.Icon("message-circle") Mensajes con @(o.BuyerNickname ?? "el comprador")</h2>
                @if (lastFromBuyer) { <span class="pill pill-warn">Espera tu respuesta</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.MessagesError))
            {
                <div class="panel-body pb-0"><div class="alert alert-warning mb-0 small">@Model.MessagesError</div></div>
            }
            <div class="od-thread" id="thread">
                @if (Model.Messages.Count == 0)
                {
                    <p class="text-muted small mb-0">Todavía no hay mensajes en esta venta. Un "gracias por tu compra" ayuda a que te califiquen bien.</p>
                }
                @foreach (var m in Model.Messages)
                {
                    <div class="od-msg @(m.FromSeller ? "is-me" : "is-buyer")">
                        <div class="od-bubble">@m.Text</div>
                        <div class="od-meta">@(m.FromSeller ? "Tú" : (o.BuyerNickname ?? "Comprador")) · @Local(m.SentAt, "dd/MM HH:mm")@(m.Status is "moderated" or "rejected" ? " · Mercado Libre no lo mostró" : "")</div>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(o.BuyerId))
            {
                <form asp-controller="PostSale" asp-action="SendMessage" method="post" class="od-reply" id="replyForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@o.Id" />
                    <div class="od-templates" aria-label="Respuestas rápidas">
                        @foreach (var t in PostSaleService.Templates)
                        {
                            <button type="button" class="pub-chip" data-template="@t">@(t.Length > 34 ? t[..32] + "…" : t)</button>
                        }
                        @if (lastFromBuyer)
                        {
                            <button type="button" class="pub-chip is-ai" id="suggestButton">@Html.Icon("sparkles", "icon-xs") Sugerir con IA</button>
                        }
                    </div>
                    <label for="messageText" class="visually-hidden">Mensaje para el comprador</label>
                    <textarea id="messageText" name="text" class="form-control" rows="3" maxlength="@PostSaleService.MaxMessageLength" placeholder="Escribe tu mensaje…" required>@draft</textarea>
                    <div class="od-reply-foot">
                        <span class="form-text m-0"><span id="msgCount">@(draft?.Length ?? 0)</span>/@PostSaleService.MaxMessageLength · Sin teléfonos, correos ni links: Mercado Libre los bloquea.</span>
                        <button type="submit" class="btn btn-primary" id="sendButton">@Html.Icon("send") Enviar</button>
                    </div>
                </form>
            }
        </section>

        <section class="panel" aria-labelledby="od-items">
            <div class="panel-head"><h2 id="od-items">Productos</h2></div>
            <ul class="od-items">
                @foreach (var item in o.Items)
                {
                    <li>
                        <span class="min-w-0">
                            <span class="fw-semibold d-block">@(item.Title ?? item.ExternalItemId)</span>
                            <span class="small text-muted">@item.ExternalItemId@(string.IsNullOrWhiteSpace(item.SellerSku) ? "" : " · SKU " + item.SellerSku)</span>
                        </span>
                        <span class="text-end text-nowrap">
                            <span class="d-block fw-bold">@((item.UnitPrice * item.Quantity).ToString("C0", mx))</span>
                            <span class="small text-muted">@item.Quantity × @item.UnitPrice.ToString("C0", mx)</span>
                        </span>
                    </li>
                }
            </ul>
        </section>
    </div>

    <aside class="od-side">
        <section class="panel" aria-labelledby="od-ship">
            <div class="panel-head"><h2 id="od-ship">Envío</h2></div>
            <div class="panel-body">
                <dl class="facts od-facts">
                    <div><dt>Estado</dt><dd>@shipLabel</dd></div>
                    @if (o.ShippingDeadline is { } d && o.NeedsShipping)
                    {
                        <div><dt>Despachar antes de</dt><dd class="@(late ? "text-danger" : "")">@Local(d, "dd/MM HH:mm")</dd></div>
                    }
                    <div><dt>Número de envío</dt><dd>@(o.ShippingId ?? "—")</dd></div>
                </dl>
            </div>
        </section>
        <section class="panel" aria-labelledby="od-pay">
            <div class="panel-head"><h2 id="od-pay">Pago y comprador</h2></div>
            <div class="panel-body">
                <dl class="facts od-facts">
                    <div><dt>Cobrado</dt><dd>@o.PaidAmount.ToString("C0", mx)</dd></div>
                    <div><dt>Comprador</dt><dd>@(o.BuyerNickname ?? "—")@if (Model.Blocked is not null) { <span class="pill pill-bad ms-1">Bloqueado</span> }</dd></div>
                    @if (o.Items.Any(i => i.SaleFee.HasValue))
                    {
                        <div><dt>Comisión de ML</dt><dd>@o.Items.Sum(i => (i.SaleFee ?? 0) * i.Quantity).ToString("C0", mx)</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(o.ExternalPackId)) { <div><dt>Carrito</dt><dd>@o.ExternalPackId</dd></div> }
                    @if (o.ProfitComputedAt is not null)
                    {
                        <div><dt>Envío a tu cargo</dt><dd>@((o.SellerShippingCostMxn ?? 0).ToString("C0", mx))<span class="sub">@(o.ShippingCostIsReal == true ? " según Mercado Libre" : " estimado")</span></dd></div>
                        <div><dt>Retención ISR + IVA</dt><dd>@((o.TaxWithheldMxn ?? 0).ToString("C0", mx))<span class="sub"> calculada (Costos de cruce)</span></dd></div>
                        <div><dt>Costo del producto</dt><dd>@(o.ProductCostMxn is { } pc ? pc.ToString("C0", mx) : "sin costo capturado")</dd></div>
                        @if (o.RealProfitMxn is { } profit)
                        {
                            <div><dt>@(profit < 0 ? "Pérdida" : "Ganancia")</dt><dd class="fw-bold @(profit < 0 ? "text-danger" : "text-success")">@Math.Abs(profit).ToString("C0", mx)</dd></div>
                        }
                    }
                </dl>
            </div>
        </section>
        @if (!string.IsNullOrWhiteSpace(o.BuyerId))
        {
            <partial name="_BlockBuyer" model="@(new MarketplaceSync.Web.ViewModels.Orders.BlockBuyerPartial(o.Id, o.BuyerNickname, Model.Blocked, Model.BuyerOrders, null))" />
        }
        @if (Model.Claims.Any(c => !c.IsOpen))
        {
            <section class="panel" aria-labelledby="od-claims">
                <div class="panel-head"><h2 id="od-claims">Reclamos cerrados</h2></div>
                <ul class="od-items">
                    @foreach (var c in Model.Claims.Where(c => !c.IsOpen))
                    {
                        <li><a asp-controller="PostSale" asp-action="Claim" asp-route-id="@c.Id">@c.ReasonLabel</a><span class="small text-muted">@Local(c.LastUpdated, "dd/MM")</span></li>
                    }
                </ul>
            </section>
        }
    </aside>
</div>

@section Scripts {
    <script>
        (function () {
            var thread = document.getElementById('thread');
            if (thread) thread.scrollTop = thread.scrollHeight;
            var text = document.getElementById('messageText'), count = document.getElementById('msgCount');
            if (!text) return;
            function update() { count.textContent = text.value.length; }
            text.addEventListener('input', update);
            document.querySelectorAll('[data-template]').forEach(function (b) {
                b.addEventListener('click', function () { text.value = b.dataset.template; update(); text.focus(); });
            });
            var suggest = document.getElementById('suggestButton');
            if (suggest) suggest.addEventListener('click', function () {
                var label = suggest.innerHTML; suggest.disabled = true; suggest.textContent = 'Pensando…';
                var data = new FormData(); data.append('orderId', '@o.Id');
                data.append('__RequestVerificationToken', document.querySelector('#replyForm input[name=__RequestVerificationToken]').value);
                fetch('@Url.Action("Suggest", "PostSale")', { method: 'POST', body: data, credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        suggest.disabled = false; suggest.innerHTML = label;
                        if (d && d.ok) { text.value = d.text; update(); text.focus(); }
                        else { suggest.textContent = 'La IA no está disponible'; }
                    });
            });
            document.getElementById('replyForm').addEventListener('submit', function () {
                var b = document.getElementById('sendButton'); setTimeout(function () { b.disabled = true; b.textContent = 'Enviando…'; }, 0);
            });
        })();
    </script>
}
