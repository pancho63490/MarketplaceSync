@model MarketplaceSync.Web.ViewModels.Orders.OrdersIndexViewModel

@{
    ViewData["Title"] = "Pedidos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="h4 mb-1">Pedidos de Mercado Libre</h2>
        <div class="text-muted">
            @Model.TotalOrders pedidos sincronizados
            @if (Model.LastSyncAt.HasValue)
            {
                <span>· Última sincronización @Model.LastSyncAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>
    </div>
    <form asp-action="Sync" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-app-primary">Sincronizar ahora</button>
    </form>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (Model.ConnectedAccounts == 0)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>Conecta una cuenta de Mercado Libre para comenzar a importar pedidos.</span>
        <a asp-controller="MercadoLibre" asp-action="Status" class="btn btn-sm btn-outline-dark">Ir a conexiones</a>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-5 col-lg-3">
                <label for="status" class="form-label fw-semibold">Estado</label>
                <select id="status" name="status" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status" selected="@(status == Model.SelectedStatus)">@status</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" type="submit">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pedido</th>
                    <th>Cuenta</th>
                    <th>Productos</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Orders.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                        No hay pedidos sincronizados. Conecta una cuenta y selecciona “Sincronizar ahora”.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">#@order.ExternalOrderId</div>
                            @if (!string.IsNullOrWhiteSpace(order.ExternalPackId))
                            {
                                <small class="text-muted">Pack @order.ExternalPackId</small>
                            }
                        </td>
                        <td>@(order.MarketplaceAccount.DisplayName ?? order.MarketplaceAccount.ExternalAccountId)</td>
                        <td>
                            @foreach (var item in order.Items.Take(2))
                            {
                                <div class="small">@item.Quantity × @(item.Title ?? item.ExternalItemId)</div>
                            }
                            @if (order.Items.Count > 2)
                            {
                                <small class="text-muted">+@(order.Items.Count - 2) más</small>
                            }
                        </td>
                        <td><span class="badge text-bg-primary">@order.Status</span></td>
                        <td class="fw-semibold">@order.TotalAmount.ToString("N2") @order.CurrencyId</td>
                        <td>@order.DateCreated.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
