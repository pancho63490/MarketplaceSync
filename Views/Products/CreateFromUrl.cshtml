@model MarketplaceSync.Web.ViewModels.CreateProductFromUrlViewModel
@inject MarketplaceSync.Services.Ai.ClaudeClient Claude

@{
    ViewData["Title"] = "Importar producto";
}

<div class="import-page">
    <h1 class="page-title">Importar producto</h1>
    <p class="text-muted mb-4">Pega el link de eBay, Amazon, AliExpress u otra tienda. La IA arma la publicación por ti.</p>

    @if (!Claude.IsConfigured)
    {
        <div class="alert alert-warning">
            La IA no está configurada todavía. Agrega la variable <code>Anthropic__ApiKey</code> en Render
            (Environment) para que escriba títulos, descripciones y atributos. Mientras tanto se usan reglas básicas.
        </div>
    }

    <form asp-action="CreateFromUrl" method="post" class="import-card" id="importForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="action" id="actionField" value="ai" />

        <label asp-for="SourceUrl" class="form-label">Link del producto</label>
        <div class="import-url">
            <input asp-for="SourceUrl" id="urlInput" class="form-control form-control-lg" placeholder="https://www.ebay.com/itm/…" autocomplete="off" autofocus />
            <span class="import-store" id="storeBadge" aria-live="polite"></span>
        </div>
        <span asp-validation-for="SourceUrl" class="text-danger small"></span>

        <ol class="import-steps" aria-label="Qué hace la IA">
            <li>Lee la foto, el precio y los datos de la tienda.</li>
            <li>Elige la categoría de Mercado Libre y llena sus atributos obligatorios.</li>
            <li>Escribe el título (máx. 60 caracteres) y la descripción en español.</li>
            <li>Calcula el precio con tus costos de cruce.</li>
        </ol>

        <div class="form-check form-switch import-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="autoPublish" name="autoPublish" value="true" checked="@(ViewBag.AutoPublishDefault == true)" />
            <label class="form-check-label" for="autoPublish">
                <strong>Publicar en automático si todo queda completo</strong>
                <span class="d-block text-muted small">Si falta algo (foto, stock o un atributo), queda como borrador para que lo revises.</span>
            </label>
        </div>

        <div class="import-actions">
            <button type="submit" class="btn btn-primary btn-lg" id="aiButton">✨ Importar con IA</button>
            <button type="submit" class="btn btn-link" id="draftButton">Solo guardar como borrador</button>
        </div>
    </form>

    <p class="small text-muted mt-3 import-note">
        eBay se lee por su API oficial. Amazon y AliExpress a veces bloquean la lectura desde servidores;
        si pasa, te avisamos qué falta completar.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('urlInput');
            var badge = document.getElementById('storeBadge');
            var form = document.getElementById('importForm');
            var action = document.getElementById('actionField');

            function store(url) {
                var u = (url || '').toLowerCase();
                if (u.includes('ebay.')) return 'eBay';
                if (u.includes('amazon.')) return 'Amazon';
                if (u.includes('aliexpress.')) return 'AliExpress';
                if (u.includes('rockauto.')) return 'RockAuto';
                if (u.includes('walmart.')) return 'Walmart';
                return u.startsWith('http') ? 'Otra tienda' : '';
            }

            function update() { badge.textContent = store(input.value); }
            input.addEventListener('input', update);
            update();

            document.getElementById('draftButton').addEventListener('click', function () { action.value = 'draft'; });
            document.getElementById('aiButton').addEventListener('click', function () { action.value = 'ai'; });

            form.addEventListener('submit', function () {
                if (window.jQuery && !$(form).valid()) return;
                var ai = action.value === 'ai';
                var button = document.getElementById(ai ? 'aiButton' : 'draftButton');
                button.disabled = true;
                button.textContent = ai ? 'Preparando con IA… (unos segundos)' : 'Guardando…';
            });
        })();
    </script>
}
