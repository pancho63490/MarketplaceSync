@model MarketplaceSync.Web.Models.Product
@using System.Globalization

@{
    var mx = CultureInfo.GetCultureInfo("es-MX");
    var ml = Model.MarketplacePublications?.FirstOrDefault(x => x.Marketplace == "MercadoLibre");
    var isPublished = ml?.IsPublished == true;
    var title = string.IsNullOrWhiteSpace(Model.Title) ? "Producto sin título" : Model.Title;
    ViewData["Title"] = title;

    var activeVariants = Model.Variants.Where(v => v.IsActive).ToList();
    var ownStock = activeVariants.Sum(v => Math.Max(0, v.Stock));

    var (stageLabel, stageTone) = isPublished
        ? (string.Equals(ml!.Status, "paused", StringComparison.OrdinalIgnoreCase) ? ("Pausado en Mercado Libre", "pill-warn") : ("Publicado en Mercado Libre", "pill-ok"))
        : Model.Status switch
        {
            "ReadyToPublish" => ("Listo para publicar", "pill-info"),
            "NeedsReview" => ("Por revisar", "pill-warn"),
            "OutOfStock" => ("Agotado en la tienda de origen", "pill-bad"),
            "Archived" => ("Archivado", ""),
            _ => ("Borrador", "")
        };

    // Lo que falta, en palabras del vendedor (el piloto automático lo deja en AutopilotNotes).
    var missing = new List<string>();
    if (!isPublished)
    {
        if (ml?.AutopilotNotes is { } notes && notes.StartsWith("Falta:", StringComparison.Ordinal))
            missing.AddRange(notes["Falta:".Length..].Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        else
        {
            if (string.IsNullOrWhiteSpace(Model.ImageUrl)) missing.Add("Foto del producto");
            if (string.IsNullOrWhiteSpace(ml?.CategoryId)) missing.Add("Categoría de Mercado Libre");
            if (ml?.Price is not > 0) missing.Add("Precio de venta");
            if (ownStock == 0 && (ml?.Stock ?? 0) == 0) missing.Add("Stock: recibe la mercancía o define cuántas piezas tienes");
        }
    }

    string ListingType(string? id) => id switch
    {
        "gold_pro" => "Premium (meses sin intereses)",
        "gold_special" => "Clásica",
        "free" => "Gratuita",
        null or "" => "—",
        _ => id
    };
    string Local(DateTime? utc) => utc.HasValue ? utc.Value.AddHours(-7).ToString("dd/MM/yyyy HH:mm") : "—";
    string SourcePrice() => Model.SourcePrice is > 0
        ? (string.Equals(Model.SourceCurrency, "MXN", StringComparison.OrdinalIgnoreCase)
            ? Model.SourcePrice.Value.ToString("C2", mx)
            : $"US$ {Model.SourcePrice.Value.ToString("0.00", CultureInfo.InvariantCulture)}")
        : "Sin precio";
}

<a asp-action="Index" class="back-link">@Html.Icon("chevron-right", "icon-xs pd-back-icon") Productos</a>

<header class="pd-head">
    <div class="pd-media">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('is-empty'); this.remove()" />
        }
        else
        {
            <span class="pd-media-empty">@Html.Icon("image", "icon-lg")<span>Sin foto</span></span>
        }
    </div>
    <div class="pd-summary">
        <span class="pill @stageTone">@stageLabel</span>
        <h1 class="pd-title">@title</h1>
        <div class="pd-meta">
            @if (!string.IsNullOrWhiteSpace(Model.Brand)) { <span>@Model.Brand</span> }
            @if (!string.IsNullOrWhiteSpace(Model.Model)) { <span>Parte @Model.Model</span> }
            <span>De @(Model.SourceMarketplace ?? "tienda sin nombre")</span>
            @if (activeVariants.Count > 0) { <span>@ownStock @(ownStock == 1 ? "pieza" : "piezas") en Juárez</span> }
        </div>
        <div class="pd-price">
            <div>
                <span class="pd-price-label">Precio en Mercado Libre</span>
                <span class="pd-price-value">@(ml?.Price is > 0 ? ml.Price.Value.ToString("C0", mx) : "Sin precio")</span>
            </div>
            <div>
                <span class="pd-price-label">Te cuesta en la tienda</span>
                <span class="pd-price-value pd-price-cost">@SourcePrice()</span>
            </div>
        </div>
        <div class="pd-actions">
            @if (isPublished)
            {
                @if (!string.IsNullOrWhiteSpace(ml!.Permalink))
                {
                    <a href="@ml.Permalink" target="_blank" rel="noopener noreferrer" class="btn btn-primary">@Html.Icon("external-link") Ver en Mercado Libre</a>
                }
                <a asp-controller="Publications" asp-action="Edit" asp-route-id="@ml.Id" class="btn btn-outline-secondary">@Html.Icon("pencil") Editar en Mercado Libre</a>
            }
            else if (missing.Count == 0)
            {
                <a asp-action="PublishToMercadoLibre" asp-route-id="@Model.Id" class="btn btn-primary">@Html.Icon("send") Publicar en Mercado Libre</a>
            }
            else
            {
                <form asp-action="CompleteWithAi" asp-route-id="@Model.Id" method="post" class="ai-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">@Html.Icon("sparkles") Completar con IA</button>
                </form>
                <a asp-action="PublishToMercadoLibre" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Revisar y publicar</a>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar datos</a>
        </div>
    </div>
</header>

<div class="pd-grid">
    <div class="pd-main">
        @if (!isPublished && missing.Count > 0)
        {
            <section class="panel pd-missing" aria-labelledby="falta">
                <div class="panel-head">
                    <h2 id="falta">@Html.Icon("list-checks") Falta para publicar</h2>
                    <p>“Completar con IA” resuelve lo que se puede sacar de los datos; lo demás complétalo en Editar.</p>
                </div>
                <ul class="pd-missing-list">
                    @foreach (var item in missing)
                    {
                        <li>@Html.Icon("circle-alert", "icon-sm") @item</li>
                    }
                </ul>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LastErrorMessage))
        {
            <div class="alert alert-danger d-flex gap-2 align-items-start">
                @Html.Icon("triangle-alert")
                <div>
                    <div class="fw-bold">Último problema (@Local(Model.LastErrorAt))</div>
                    <div class="small">@Model.LastErrorMessage</div>
                </div>
            </div>
        }

        <section class="panel" aria-labelledby="descripcion">
            <div class="panel-head"><h2 id="descripcion">Descripción</h2></div>
            <div class="panel-body">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-0">Sin descripción. La IA la escribe con “Completar con IA”.</p>
                }
                else
                {
                    <div class="pd-description" id="pdDescription">@Model.Description</div>
                    <button type="button" class="btn btn-link btn-sm px-0 mt-1" id="pdMore" hidden>Ver toda la descripción</button>
                }
            </div>
        </section>
    </div>

    <aside class="pd-side">
        <section class="panel" aria-labelledby="ml-datos">
            <div class="panel-head"><h2 id="ml-datos">En Mercado Libre</h2></div>
            <div class="panel-body">
                <dl class="facts pd-facts">
                    <div><dt>Publicación</dt><dd class="@(string.IsNullOrWhiteSpace(ml?.ExternalItemId) ? "is-missing" : "")">@(ml?.ExternalItemId ?? "Sin publicar")</dd></div>
                    <div><dt>Categoría</dt><dd class="@(string.IsNullOrWhiteSpace(ml?.CategoryId) ? "is-missing" : "")">@(ml?.CategoryId ?? "Sin elegir")</dd></div>
                    <div><dt>Piezas publicadas</dt><dd>@(ml?.Stock?.ToString() ?? "—")</dd></div>
                    <div><dt>Tipo de publicación</dt><dd>@ListingType(ml?.ListingTypeId)</dd></div>
                    <div><dt>Condición</dt><dd>@(ml?.Condition == "used" ? "Usado" : "Nuevo")</dd></div>
                    <div><dt>Publicado el</dt><dd>@Local(ml?.PublishedAt)</dd></div>
                </dl>
            </div>
        </section>

        <section class="panel" aria-labelledby="origen">
            <div class="panel-head">
                <h2 id="origen">Tienda de origen</h2>
                @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                {
                    <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer" class="small">Abrir @Html.Icon("external-link", "icon-xs")</a>
                }
            </div>
            <div class="panel-body">
                <dl class="facts pd-facts">
                    <div><dt>Tienda</dt><dd>@(Model.SourceMarketplace ?? "—")</dd></div>
                    <div><dt>Precio</dt><dd>@SourcePrice()</dd></div>
                    <div><dt>Disponibilidad</dt><dd class="@(Model.SourceAvailabilityText is null && Model.SourceStock is null ? "is-missing" : "")">@(Model.SourceAvailabilityText ?? (Model.SourceStock is > 0 ? "Disponible" : Model.SourceStock == 0 ? "Agotado" : "Sin dato"))</dd></div>
                    <div><dt>Revisado</dt><dd>@Local(Model.LastSourceCheckAt)</dd></div>
                </dl>
                <form asp-action="RefreshProduct" asp-route-id="@Model.Id" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@Html.Icon("refresh-cw") Revisar precio ahora</button>
                </form>
            </div>
        </section>

        <section class="panel" aria-labelledby="skus">
            <div class="panel-head">
                <h2 id="skus">SKU y variantes</h2>
                <a asp-action="Variants" asp-route-id="@Model.Id" class="small">Administrar</a>
            </div>
            <div class="panel-body">
                @if (activeVariants.Count == 0)
                {
                    <p class="text-muted small mb-0">Sin SKU. Se crea al recibir la compra, o agrégalo en Administrar para controlar el stock desde la app.</p>
                }
                else
                {
                    <ul class="pd-skus">
                        @foreach (var v in activeVariants)
                        {
                            <li><span>@v.Sku</span><span class="pill @(v.Stock <= 0 ? "pill-bad" : v.Stock <= v.LowStockThreshold ? "pill-warn" : "pill-ok")">@v.Stock pzs</span></li>
                        }
                    </ul>
                }
            </div>
        </section>

        <p class="small text-muted">
            Creado el @Local(Model.CreatedAt).
            <a asp-action="Delete" asp-route-id="@Model.Id" class="text-danger ms-1">Eliminar producto</a>
        </p>
    </aside>
</div>

@section Scripts {
    <script>
        (function () {
            var d = document.getElementById('pdDescription'), b = document.getElementById('pdMore');
            if (!d || !b) return;
            if (d.scrollHeight > d.clientHeight + 4) b.hidden = false;
            b.addEventListener('click', function () { d.classList.add('is-open'); b.remove(); });
        })();
        document.querySelectorAll('.ai-form').forEach(function (f) {
            f.addEventListener('submit', function () {
                var btn = f.querySelector('button');
                setTimeout(function () { btn.disabled = true; btn.textContent = 'Completando con IA…'; }, 0);
            });
        });
    </script>
}
