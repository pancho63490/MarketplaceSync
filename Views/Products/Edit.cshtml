@model MarketplaceSync.Web.Models.Product

@{
    ViewData["Title"] = "Editar producto";
    var mlPublication = Model.MarketplacePublications?
        .FirstOrDefault(x => x.Marketplace == "MercadoLibre");
}

<div class="container-fluid px-4 py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Editar producto</h1>
            <p class="text-muted mb-0">
                Revisa y ajusta la información antes de publicarlo en Mercado Libre.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Volver
            </a>

            <a asp-controller="Products"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-dark">
                Ver detalle
            </a>

            <a asp-controller="Products"
               asp-action="PublishToMercadoLibre"
               asp-route-id="@Model.Id"
               class="btn btn-success">
                Publicar en Mercado Libre
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="fw-bold mb-3">Vista rápida</h5>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Title"
                             class="img-fluid rounded border mb-3"
                             style="width:100%; max-height:320px; object-fit:contain;" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-flex align-items-center justify-content-center mb-3"
                             style="height:260px;">
                            <span class="text-muted">Sin imagen</span>
                        </div>
                    }

                    <div class="mb-2">
                        <span class="text-muted small">Marketplace origen</span>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.SourceMarketplace) ? "N/A" : Model.SourceMarketplace)
                        </div>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small">Source ID</span>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.SourceProductId) ? "N/A" : Model.SourceProductId)
                        </div>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small">Estado interno</span>
                        <div>
                            <span class="badge bg-secondary">
                                @(string.IsNullOrWhiteSpace(Model.Status) ? "N/A" : Model.Status)
                            </span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small">Última revisión origen</span>
                        <div class="fw-semibold">
                            @(Model.LastSourceCheckAt.HasValue
                                ? Model.LastSourceCheckAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                : "Sin revisar")
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                    {
                        <a href="@Model.SourceUrl"
                           target="_blank"
                           class="btn btn-sm btn-outline-primary w-100 mt-3">
                            Abrir producto origen
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(mlPublication?.Permalink))
                    {
                        <a href="@mlPublication.Permalink"
                           target="_blank"
                           class="btn btn-sm btn-outline-success w-100 mt-2">
                            Ver publicación en Mercado Libre
                        </a>
                    }

                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Acciones rápidas</h5>

                    <form asp-controller="Products"
                          asp-action="RefreshSource"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary w-100">
                            Actualizar info desde origen
                        </button>
                    </form>

                    <form asp-controller="Products"
                          asp-action="PrepareForMercadoLibre"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-dark w-100">
                            Preparar para Mercado Libre
                        </button>
                    </form>

                    <a asp-controller="Products"
                       asp-action="PublishToMercadoLibre"
                       asp-route-id="@Model.Id"
                       class="btn btn-success w-100">
                        Publicar en Mercado Libre
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">

            <form asp-controller="Products"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0">Información general</h5>
                    </div>

                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Título</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Descripción</label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Brand" class="form-label fw-semibold">Marca</label>
                                <input asp-for="Brand" class="form-control" />
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label fw-semibold">Modelo</label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">Imagen URL</label>
                            <input asp-for="ImageUrl" class="form-control" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0">Datos del origen</h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="SourcePrice" class="form-label fw-semibold">Precio origen</label>
                                <input asp-for="SourcePrice" class="form-control" />
                                <span asp-validation-for="SourcePrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SourceCurrency" class="form-label fw-semibold">Moneda origen</label>
                                <input asp-for="SourceCurrency" class="form-control" />
                                <span asp-validation-for="SourceCurrency" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SourceStock" class="form-label fw-semibold">Stock origen</label>
                                <input asp-for="SourceStock" class="form-control" />
                                <span asp-validation-for="SourceStock" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label asp-for="SourceAvailabilityText" class="form-label fw-semibold">Disponibilidad origen</label>
                            <input asp-for="SourceAvailabilityText" class="form-control" />
                            <span asp-validation-for="SourceAvailabilityText" class="text-danger small"></span>
                        </div>

                        <div class="mt-3">
                            <label asp-for="SourceStatus" class="form-label fw-semibold">Status origen</label>
                            <input asp-for="SourceStatus" class="form-control" />
                            <span asp-validation-for="SourceStatus" class="text-danger small"></span>
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0">Publicación por canal</h5>
                    </div>

                    <div class="card-body">
                        <p class="text-muted">Precio, stock, categoría, estado y enlace se administran por publicación.</p>
                        @if (mlPublication != null)
                        {
                            <div class="d-flex gap-2 align-items-center mb-3">
                                <span class="badge @(mlPublication.IsPublished ? "bg-success" : "bg-secondary")">
                                    @(mlPublication.IsPublished ? "Publicado" : "Borrador")
                                </span>
                                <span>@(mlPublication.MarketplaceAccount?.DisplayName ?? "Mercado Libre")</span>
                            </div>
                        }
                        <a asp-controller="Products" asp-action="PublishToMercadoLibre" asp-route-id="@Model.Id" class="btn btn-outline-success">
                            Configurar publicación en Mercado Libre
                        </a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex flex-wrap justify-content-between gap-2">

                        <div>
                            <a asp-controller="Products"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                Guardar cambios
                            </button>

                        <a asp-controller="Products"

   asp-action="PublishToMercadoLibre"

   asp-route-id="@Model.Id"

   class="btn btn-success">

    Publicar en Mercado Libre

</a>
                        </div>

                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
