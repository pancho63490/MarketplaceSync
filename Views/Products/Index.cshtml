@model IEnumerable<MarketplaceSync.Web.Models.Product>

@{
    ViewData["Title"] = "Productos";

    var products = Model?.ToList() ?? new List<MarketplaceSync.Web.Models.Product>();

    var totalProducts = products.Count;
    var ebayCount = products.Count(x => string.Equals(x.SourceMarketplace, "eBay", StringComparison.OrdinalIgnoreCase));
    var amazonCount = products.Count(x => string.Equals(x.SourceMarketplace, "Amazon", StringComparison.OrdinalIgnoreCase));
    var mlPublishedCount = products.Count(x => !string.IsNullOrWhiteSpace(x.MercadoLibreItemId));
    var outOfStockCount = products.Count(x => x.SourceStock.HasValue && x.SourceStock.Value <= 0);
    var needsReviewCount = products.Count(x => string.Equals(x.Status, "NeedsReview", StringComparison.OrdinalIgnoreCase));
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <div class="text-uppercase text-muted fw-bold small mb-2">MarketplaceSync</div>
        <h1 class="fw-bold display-6 mb-2">Productos</h1>
        <p class="text-muted mb-0">
            Administra productos importados, revisa precio/stock y prepara publicaciones para Mercado Libre.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <form asp-controller="Products"
              asp-action="RefreshAllSourceInfo"
              method="post"
              class="d-inline"
              onsubmit="return confirm('¿Deseas actualizar la información de todos los productos?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary">
                Actualizar todos
            </button>
        </form>

        <a asp-controller="Products"
           asp-action="CreateFromUrl"
           class="btn btn-primary">
            + Agregar por link
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Total</div>
                <div class="fs-3 fw-bold">@totalProducts</div>
                <div class="small text-muted">productos registrados</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">eBay</div>
                <div class="fs-3 fw-bold">@ebayCount</div>
                <div class="small text-muted">productos fuente</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Amazon</div>
                <div class="fs-3 fw-bold">@amazonCount</div>
                <div class="small text-muted">pendiente API oficial</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Publicados ML</div>
                <div class="fs-3 fw-bold text-success">@mlPublishedCount</div>
                <div class="small text-muted">con item publicado</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Sin stock</div>
                <div class="fs-3 fw-bold text-danger">@outOfStockCount</div>
                <div class="small text-muted">requieren revisión</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold">Needs Review</div>
                <div class="fs-3 fw-bold text-warning">@needsReviewCount</div>
                <div class="small text-muted">preparación pendiente</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="fw-bold mb-1">Listado de productos</h5>
                <div class="text-muted small">
                    Última carga de pantalla: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-primary">eBay</span>
                <span class="badge bg-warning text-dark">Amazon</span>
                <span class="badge bg-success">Mercado Libre</span>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        @if (!products.Any())
        {
            <div class="text-center py-5 px-3">
                <div class="display-5 mb-3">📦</div>
                <h5 class="fw-bold">Todavía no hay productos</h5>
                <p class="text-muted mb-4">
                    Agrega tu primer producto usando un link de eBay, Amazon o Mercado Libre.
                </p>
                <a asp-controller="Products"
                   asp-action="CreateFromUrl"
                   class="btn btn-primary">
                    Agregar producto
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th style="width: 90px;">Imagen</th>
                            <th>Producto</th>
                            <th style="width: 130px;">Fuente</th>
                            <th style="width: 130px;">Precio</th>
                            <th style="width: 160px;">Stock</th>
                            <th style="width: 150px;">Estado</th>
                            <th style="width: 160px;">Revisión</th>
                            <th style="width: 330px;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in products)
                        {
                            var marketplace = item.SourceMarketplace ?? "N/A";
                            var status = item.Status ?? "N/A";
                            var isPublished = !string.IsNullOrWhiteSpace(item.MercadoLibreItemId);
                            var hasStock = item.SourceStock.HasValue && item.SourceStock.Value > 0;
                            var noStock = item.SourceStock.HasValue && item.SourceStock.Value <= 0;

                            <tr>
                                <td class="fw-bold">
                                    @item.Id
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Title"
                                             class="rounded border bg-light"
                                             style="width:64px;height:64px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded border bg-light d-flex align-items-center justify-content-center"
                                             style="width:64px;height:64px;">
                                            <span class="small text-muted">N/A</span>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="fw-bold mb-1">
                                        @(string.IsNullOrWhiteSpace(item.Title) ? "Sin título" : item.Title)
                                    </div>

                                    <div class="small text-muted">
                                        Source ID:
                                        <span class="fw-semibold">
                                            @(string.IsNullOrWhiteSpace(item.SourceProductId) ? "N/A" : item.SourceProductId)
                                        </span>
                                    </div>

                                    <div class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(item.Brand))
                                        {
                                            <span>Marca: @item.Brand</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.Model))
                                        {
                                            <span class="ms-2">Modelo: @item.Model</span>
                                        }
                                    </div>

                                    <div class="small mt-1">
                                        @if (!string.IsNullOrWhiteSpace(item.SourceUrl))
                                        {
                                            <a href="@item.SourceUrl" target="_blank" class="text-decoration-none">
                                                Abrir origen
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.MercadoLibrePermalink))
                                        {
                                            <span class="text-muted mx-1">|</span>
                                            <a href="@item.MercadoLibrePermalink" target="_blank" class="text-decoration-none">
                                                Ver ML
                                            </a>
                                        }
                                    </div>
                                </td>

                                <td>
                                    @if (string.Equals(marketplace, "eBay", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-primary">eBay</span>
                                    }
                                    else if (string.Equals(marketplace, "Amazon", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">Amazon</span>
                                    }
                                    else if (string.Equals(marketplace, "MercadoLibre", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info text-dark">Mercado Libre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@marketplace</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.SourceStatus))
                                    {
                                        <div class="small text-muted mt-1">
                                            @item.SourceStatus
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (item.SourcePrice.HasValue)
                                    {
                                        <div class="fw-bold">
                                            @item.SourcePrice.Value.ToString("N2")
                                        </div>
                                        <div class="small text-muted">
                                            @(item.SourceCurrency ?? "")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }

                                    @if (item.MercadoLibrePrice.HasValue)
                                    {
                                        <div class="small text-success mt-1">
                                            ML: @item.MercadoLibrePrice.Value.ToString("N2") @(item.MercadoLibreCurrencyId ?? "MXN")
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (hasStock)
                                    {
                                        <span class="badge bg-success">
                                            @item.SourceStock
                                        </span>
                                    }
                                    else if (noStock)
                                    {
                                        <span class="badge bg-danger">
                                            0
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            N/A
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.SourceAvailabilityText))
                                    {
                                        <div class="small text-muted mt-1">
                                            @item.SourceAvailabilityText
                                        </div>
                                    }

                                    @if (item.MercadoLibreStock.HasValue)
                                    {
                                        <div class="small text-success mt-1">
                                            ML stock: @item.MercadoLibreStock
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (isPublished)
                                    {
                                        <span class="badge bg-success">Publicado ML</span>
                                    }
                                    else if (string.Equals(status, "Draft", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">Draft</span>
                                    }
                                    else if (string.Equals(status, "NeedsReview", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info text-dark">Needs Review</span>
                                    }
                                    else if (string.Equals(status, "OutOfStock", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">Sin stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@status</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.MercadoLibreItemId))
                                    {
                                        <div class="small text-muted mt-1">
                                            ML: @item.MercadoLibreItemId
                                        </div>
                                    }
                                </td>

                                <td>
                                    @if (item.LastSourceCheckAt.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            @item.LastSourceCheckAt.Value.ToLocalTime().ToString("yyyy-MM-dd")
                                        </div>
                                        <div class="small text-muted">
                                            @item.LastSourceCheckAt.Value.ToLocalTime().ToString("HH:mm")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin revisar</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Ver
                                        </a>

                                        <a asp-controller="Products"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            Editar
                                        </a>

                                        <form asp-controller="Products"
                                              asp-action="RefreshSource"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                Actualizar
                                            </button>
                                        </form>

                                        <a asp-controller="Products"
                                           asp-action="PublishToMercadoLibre"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-success">
                                            Publicar ML
                                        </a>

                                        <form asp-controller="Products"
                                              asp-action="DeleteConfirmed"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Seguro que deseas borrar este producto? Solo se borrará de MarketplaceSync, no de Mercado Libre.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Borrar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>