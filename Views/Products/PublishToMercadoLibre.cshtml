@model MarketplaceSync.Web.ViewModels.PublishToMercadoLibreRequest
@{
    Model.Attributes ??= new();
}

@{
    ViewData["Title"] = "Publicar en Mercado Libre";

    var hasCategory = !string.IsNullOrWhiteSpace(Model.CategoryId);
    var hasImage = !string.IsNullOrWhiteSpace(Model.ImageUrl);
    var hasPrice = Model.Price > 0;
    var hasStock = Model.Stock > 0;
    var attributesLoaded = Model.AttributesLoaded;
    var requiredAttributes = Model.Attributes?.Where(x => x.Required).ToList() ?? new();
    var gtinReasonChosen = Model.Attributes?.Any(x => x.Id == MarketplaceSync.Services.MercadoLibre.MercadoLibreListingClient.EmptyGtinReasonId &&
        (!string.IsNullOrWhiteSpace(x.ValueId) || !string.IsNullOrWhiteSpace(x.ValueName))) == true;
    var completedAttributeCount = requiredAttributes.Count(x =>
        !string.IsNullOrWhiteSpace(x.ValueId) || !string.IsNullOrWhiteSpace(x.ValueName) ||
        (x.Id == MarketplaceSync.Services.MercadoLibre.MercadoLibreListingClient.GtinId && gtinReasonChosen));
    var attributesComplete = attributesLoaded && completedAttributeCount == requiredAttributes.Count;
    var readinessChecks = new[] { hasCategory, hasPrice, hasStock, hasImage, attributesComplete };
    var readinessPercent = readinessChecks.Count(x => x) * 100 / readinessChecks.Length;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        
        <h1 class="page-title">Publicar en Mercado Libre</h1>
        <p class="text-muted mb-0">
            Completa categoría, precio, stock, imagen y atributos antes de enviar la publicación.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Products"
           asp-action="Edit"
           asp-route-id="@Model.ProductId"
           class="btn btn-outline-secondary">
            Volver a editar
        </a>

        <a asp-controller="Products"
           asp-action="Details"
           asp-route-id="@Model.ProductId"
           class="btn btn-outline-dark">
            Ver detalle
        </a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger shadow-sm">
        @{
            var errorText = Model.ErrorMessage!;
            const string rejectedPrefix = "Mercado Libre rechazó la publicación: ";
            var rejected = errorText.StartsWith(rejectedPrefix, StringComparison.Ordinal);
            var errorParts = (rejected ? errorText[rejectedPrefix.Length..] : errorText)
                .Split(" · ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        }
        <div class="fw-bold mb-1">@(rejected ? "Mercado Libre no aceptó la publicación" : "Error Mercado Libre")</div>
        @if (errorParts.Length > 1)
        {
            <ul class="mb-0 ps-3">
                @foreach (var part in errorParts)
                {
                    <li>@part</li>
                }
            </ul>
        }
        else
        {
            <div>@errorParts.FirstOrDefault()</div>
        }
    </div>
}



<form asp-controller="Products"
      asp-action="PublishToMercadoLibre"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="AttributesLoaded" />

    <div class="mb-3">
        <label asp-for="MarketplaceAccountId" class="form-label fw-semibold">Cuenta de Mercado Libre</label>
        @if (Model.Accounts.Count > 1)
        {
            <select asp-for="MarketplaceAccountId" asp-items="Model.Accounts" class="form-select">
                <option value="">Selecciona una cuenta</option>
            </select>
        }
        else if (Model.Accounts.Count == 1)
        {
            <input type="hidden" asp-for="MarketplaceAccountId" />
            <div class="form-control bg-light">@Model.Accounts[0].Text</div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                Conecta una cuenta antes de publicar.
                <a asp-controller="MercadoLibre" asp-action="Status" class="alert-link">Administrar cuentas</a>
            </div>
        }
        <span asp-validation-for="MarketplaceAccountId" class="text-danger small"></span>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">

        <div class="col-12 col-xl-4">

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">

                    <div class="rounded border bg-light d-flex align-items-center justify-content-center overflow-hidden mb-3"
                         style="min-height: 300px;">
                        @if (hasImage)
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.Title"
                                 class="img-fluid"
                                 style="max-height: 320px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-center text-muted p-4">
                                <div class="display-6 mb-2">🖼️</div>
                                <div>Sin imagen</div>
                            </div>
                        }
                    </div>

                    <h4 class="fw-bold mb-2">
                        @(string.IsNullOrWhiteSpace(Model.Title) ? "Producto sin título" : Model.Title)
                    </h4>

                    <p class="text-muted mb-3">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "Sin descripción disponible."
                            : Model.Description)
                    </p>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-success">Mercado Libre</span>

                        @if (hasCategory)
                        {
                            <span class="badge bg-primary">@Model.CategoryId</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Sin categoría</span>
                        }
                    </div>

                    <div class="border rounded p-3 bg-light mb-2">
                        <div class="text-muted small fw-semibold">Precio</div>
                        <div class="fs-4 fw-bold">
                            @Model.Price.ToString("N2") @Model.CurrencyId
                        </div>
                    </div>

                    <div class="border rounded p-3 bg-light">
                        <div class="text-muted small fw-semibold">Stock</div>
                        <div class="fs-4 fw-bold">
                            @Model.Stock
                        </div>
                    </div>

                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <h5 class="fw-bold mb-0">Checklist de publicación</h5>
                        <span class="publication-readiness">@readinessPercent%</span>
                    </div>
                    <div class="progress mt-3" style="height: 6px;">
                        <div class="progress-bar @(readinessPercent == 100 ? "bg-success" : "bg-primary")"
                             role="progressbar"
                             style="width: @readinessPercent%"
                             aria-valuenow="@readinessPercent"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="card-body">

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge @(hasCategory ? "bg-success" : "bg-danger")">
                            @(hasCategory ? "OK" : "Falta")
                        </span>
                        <span>Categoría Mercado Libre</span>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge @(hasPrice ? "bg-success" : "bg-danger")">
                            @(hasPrice ? "OK" : "Falta")
                        </span>
                        <span>Precio mayor a cero</span>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge @(hasStock ? "bg-success" : "bg-danger")">
                            @(hasStock ? "OK" : "Falta")
                        </span>
                        <span>Stock disponible</span>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge @(hasImage ? "bg-success" : "bg-warning text-dark")">
                            @(hasImage ? "OK" : "Revisar")
                        </span>
                        <span>Imagen</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(attributesComplete ? "bg-success" : attributesLoaded ? "bg-warning text-dark" : "bg-danger")">
                            @(attributesComplete ? "OK" : attributesLoaded ? "Falta" : "No cargados")
                        </span>
                        <span>Atributos obligatorios (@completedAttributeCount/@requiredAttributes.Count)</span>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-12 col-xl-8">

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Datos principales</h5>
                    <div class="small text-muted">
                        Mercado Libre valida estos datos antes de aceptar la publicación.
                    </div>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Título</label>
                        <input asp-for="Title" class="form-control" maxlength="60" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                        <div class="form-text">
                            Mercado Libre normalmente limita el título. Usa un título claro y sin palabras repetidas.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">Precio</label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold">Stock</label>
                            <input asp-for="Stock" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CurrencyId" class="form-label fw-semibold">Moneda</label>
                            <select asp-for="CurrencyId" class="form-select">
                                <option value="MXN">MXN</option>
                                <option value="USD">USD</option>
                            </select>
                            <span asp-validation-for="CurrencyId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Imagen URL</label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Categoría Mercado Libre</h5>
                    <div class="small text-muted">
                        La categoría define los atributos obligatorios.
                    </div>
                </div>

                <div class="card-body">

                    <div class="row g-3 align-items-end">
                        <div class="col-lg-7">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Categoría</label>
                            <input asp-for="CategoryId"
                                   class="form-control"
                                   placeholder="Ejemplo: MLM189898" />
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            <div class="form-text">
                                Usa una categoría de Mercado Libre México con prefijo MLM.
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit"
                                        formaction="@Url.Action("SuggestMercadoLibreCategories", "Products")"
                                        formmethod="post"
                                        formnovalidate
                                        class="btn btn-outline-secondary flex-grow-1 cancel">
                                    Sugerir por título
                                </button>
                                <button type="submit"
                                        formaction="@Url.Action("LoadMercadoLibreAttributes", "Products")"
                                        formmethod="post"
                                        formnovalidate
                                        class="btn btn-outline-primary flex-grow-1 cancel">
                                    Cargar atributos
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (Model.CategorySuggestions.Any())
                    {
                        <div class="category-suggestions mt-4">
                            <div class="small fw-bold text-muted mb-2">Categorías sugeridas</div>
                            <div class="row g-2">
                                @foreach (var suggestion in Model.CategorySuggestions.Where(x => !string.IsNullOrWhiteSpace(x.Category_Id)))
                                {
                                    <div class="col-md-6">
                                        <button type="button"
                                                class="category-suggestion @(suggestion.Category_Id == Model.CategoryId ? "selected" : "")"
                                                data-category-id="@suggestion.Category_Id">
                                            <span class="category-suggestion-check">✓</span>
                                            <span>
                                                <strong>@(suggestion.Category_Name ?? suggestion.Category_Id)</strong>
                                                <small>@suggestion.Category_Id · @(suggestion.Domain_Name ?? "Mercado Libre")</small>
                                            </span>
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="form-text mt-2">Selecciona una sugerencia y después presiona “Cargar atributos”.</div>
                        </div>
                    }

                    @if (!hasCategory)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            Primero ingresa una categoría de Mercado Libre y después carga atributos.
                        </div>
                    }
                    else if (attributesLoaded)
                    {
                        <div class="alert alert-info mt-3 mb-0 py-2">
                            Los atributos obligatorios se cargaron automáticamente para <strong>@Model.CategoryId</strong>.
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.AttributeLoadError))
                    {
                        <div class="alert alert-warning mt-3 mb-0">@Model.AttributeLoadError</div>
                    }

                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Configuración de publicación</h5>
                </div>

                <div class="card-body">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Condition" class="form-label fw-semibold">Condición</label>
                            <select asp-for="Condition" class="form-select">
                                <option value="new">Nuevo</option>
                                <option value="used">Usado</option>
                                <option value="not_specified">No especificado</option>
                            </select>
                            <span asp-validation-for="Condition" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ListingTypeId" class="form-label fw-semibold">Tipo de publicación</label>
                            <select asp-for="ListingTypeId" class="form-select">
                                <option value="gold_special">Clásica</option>
                                <option value="gold_pro">Premium</option>
                                <option value="free">Gratuita</option>
                            </select>
                            <span asp-validation-for="ListingTypeId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label fw-semibold">Marca</label>
                            <input asp-for="Brand" class="form-control" />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Model" class="form-label fw-semibold">Modelo / MPN</label>
                            <input asp-for="Model" class="form-control" />
                            <span asp-validation-for="Model" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>

            @if (Model.Attributes != null && Model.Attributes.Any())
            {
                const string gtinId = MarketplaceSync.Services.MercadoLibre.MercadoLibreListingClient.GtinId;
                const string reasonId = MarketplaceSync.Services.MercadoLibre.MercadoLibreListingClient.EmptyGtinReasonId;
                var mainIndexes = Enumerable.Range(0, Model.Attributes.Count)
                    .Where(i => Model.Attributes[i].Required || Model.Attributes[i].Flagged || Model.Attributes[i].Id is gtinId or reasonId)
                    .ToList();
                var extraIndexes = Enumerable.Range(0, Model.Attributes.Count).Except(mainIndexes).ToList();
                var flaggedCount = Model.Attributes.Count(a => a.Flagged);

                async Task AttributeRow(int i)
                {
                    var attr = Model.Attributes[i];
                    var isGtin = attr.Id == gtinId;
                    var isReason = attr.Id == reasonId;
                    <div class="ml-attr mb-3 @(attr.Flagged ? "ml-attr-flagged" : "")" data-attr-id="@attr.Id">
                        <input type="hidden" asp-for="Attributes[i].Id" />
                        <input type="hidden" asp-for="Attributes[i].Name" />
                        <input type="hidden" asp-for="Attributes[i].Required" />
                        <input type="hidden" asp-for="Attributes[i].Conditional" />
                        <input type="hidden" asp-for="Attributes[i].Flagged" />
                        <input type="hidden" asp-for="Attributes[i].ValueType" />

                        <label class="form-label fw-semibold d-flex flex-wrap align-items-center gap-2" for="@(isGtin || attr.Values.Count == 0 ? $"Attributes_{i}__ValueName" : $"Attributes_{i}__ValueId")">
                            <span>@(isGtin ? "Código de barras (GTIN)" : isReason ? "Sin código de barras: ¿por qué?" : attr.Name)</span>
                            @if (attr.Required && !isReason)
                            {
                                <span class="text-danger">*</span>
                            }
                            @if (attr.Flagged)
                            {
                                <span class="pill pill-warn">Mercado Libre lo pidió</span>
                            }
                        </label>

                        @if (isGtin)
                        {
                            <div class="input-group">
                                <input asp-for="Attributes[i].ValueName"
                                       class="form-control ml-gtin"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       placeholder="Ej. 070847898412" />
                                <button type="button" class="btn btn-outline-secondary ml-gtin-scan" hidden>Escanear</button>
                            </div>
                            <video class="ml-gtin-camera mt-2 rounded w-100" playsinline muted hidden></video>
                            <span asp-validation-for="Attributes[i].ValueName" class="text-danger small"></span>
                            <div class="form-text">
                                Son los números debajo de las barras (UPC de 12 dígitos o EAN de 13) en la lata, caja o empaque.
                                Se revisa el último dígito para no mandar un código mal copiado.
                            </div>
                        }
                        else
                        {
                            @if (attr.Values != null && attr.Values.Any())
                            {
                                <select asp-for="Attributes[i].ValueId"
                                        class="form-select ml-attribute-select"
                                        data-value-name-target="Attributes_@(i)__ValueName">
                                    <option value="">@(isReason ? "Sí tiene código (déjalo así)" : "Selecciona una opción")</option>

                                    @foreach (var option in attr.Values)
                                    {
                                        var optionValue = string.IsNullOrWhiteSpace(option.Id)
                                            ? $"name:{option.Name}"
                                            : option.Id;
                                        <option value="@optionValue" data-value-name="@option.Name">@option.Name</option>
                                    }
                                </select>
                                <input type="hidden" asp-for="Attributes[i].ValueName" />
                            }
                            else
                            {
                                <input asp-for="Attributes[i].ValueName"
                                       class="form-control"
                                       placeholder="Ingresa valor" />
                            }

                            <span asp-validation-for="Attributes[i].ValueName" class="text-danger small"></span>

                            <div class="form-text">
                                @if (isReason)
                                {
                                    <text>Elígelo solo si el producto de verdad no trae código de barras (por ejemplo, una pieza suelta o hecha a mano).</text>
                                }
                                else
                                {
                                    <text>ID atributo: @attr.Id</text>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="fw-bold mb-0">Atributos requeridos</h5>
                        <div class="small text-muted">
                            @if (flaggedCount > 0)
                            {
                                <text>Mercado Libre pidió @flaggedCount @(flaggedCount == 1 ? "dato" : "datos") más: están marcados abajo.</text>
                            }
                            else
                            {
                                <text>Completa los atributos que Mercado Libre pide para esta categoría.</text>
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        @foreach (var i in mainIndexes)
                        {
                            await AttributeRow(i);
                        }

                        @if (extraIndexes.Count > 0)
                        {
                            var extraFilled = extraIndexes.Count(i => !string.IsNullOrWhiteSpace(Model.Attributes[i].ValueId) || !string.IsNullOrWhiteSpace(Model.Attributes[i].ValueName));
                            <details class="ml-attr-extra" @(mainIndexes.Count == 0 ? "open" : "")>
                                <summary class="fw-semibold">
                                    Puede pedirlos según el producto (@extraFilled/@extraIndexes.Count)
                                    <span class="small text-muted fw-normal d-block">Llénalos si aplican; así Mercado Libre no rechaza la publicación.</span>
                                </summary>
                                <div class="pt-3">
                                    @foreach (var i in extraIndexes)
                                    {
                                        await AttributeRow(i);
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm mb-4 profitability-card">
                <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <h5 class="fw-bold mb-0">Calculadora de rentabilidad</h5>
                        <div class="small text-muted">La comisión se consulta en tiempo real con Mercado Libre.</div>
                    </div>
                    <span class="profitability-estimate-badge">Estimación</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 col-xl-3">
                            <label asp-for="UnitCost" class="form-label fw-semibold">Costo del producto</label>
                            <input asp-for="UnitCost" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="UnitCost" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label asp-for="ShippingCost" class="form-label fw-semibold">Envío a tu cargo</label>
                            <input asp-for="ShippingCost" class="form-control" type="number" min="0" step="0.01" />
                            <span asp-validation-for="ShippingCost" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label asp-for="OtherCosts" class="form-label fw-semibold">Otros costos</label>
                            <input asp-for="OtherCosts" class="form-control" type="number" min="0" step="0.01" />
                            <span asp-validation-for="OtherCosts" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <label asp-for="TaxRate" class="form-label fw-semibold">Impuestos estimados %</label>
                            <input asp-for="TaxRate" class="form-control" type="number" min="0" max="100" step="0.01" />
                            <span asp-validation-for="TaxRate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                        <button type="button" id="calculate-profitability" class="btn btn-outline-primary">
                            Calcular rentabilidad
                        </button>
                        <span id="profitability-loading" class="small text-muted d-none">Consultando comisión oficial…</span>
                        <span id="profitability-error" class="small text-danger"></span>
                    </div>

                    <div id="profitability-result" class="profitability-result mt-4 d-none">
                        <div class="profitability-metric">
                            <span>Comisión ML</span>
                            <strong id="profitability-fee">—</strong>
                            <small id="profitability-fee-detail"></small>
                        </div>
                        <div class="profitability-metric">
                            <span>Utilidad neta</span>
                            <strong id="profitability-profit">—</strong>
                            <small>Después de los costos capturados</small>
                        </div>
                        <div class="profitability-metric">
                            <span>Margen</span>
                            <strong id="profitability-margin">—</strong>
                            <small>Utilidad / precio de venta</small>
                        </div>
                        <div class="profitability-metric">
                            <span>Precio mínimo</span>
                            <strong id="profitability-break-even">—</strong>
                            <small>Estimado para no perder</small>
                        </div>
                        <div class="profitability-status" id="profitability-status">—</div>
                    </div>

                    <div class="form-text mt-3">
                        El envío e impuestos son editables. El costo oficial puede variar por logística, peso, situación fiscal y condiciones comerciales de tu cuenta.
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-5">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h5 class="fw-bold mb-1">Enviar publicación</h5>
                            <p class="text-muted mb-0">
                                Al publicar, se enviará el producto a Mercado Libre usando la cuenta conectada.
                            </p>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Products"
                               asp-action="Edit"
                               asp-route-id="@Model.ProductId"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-success"
                                    onclick="return confirm('¿Seguro que deseas publicar este producto en Mercado Libre?');">
                                Publicar en Mercado Libre
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.category-suggestion').forEach(function (button) {
            button.addEventListener('click', function () {
                var categoryInput = document.getElementById('CategoryId');
                categoryInput.value = button.dataset.categoryId;
                document.querySelectorAll('.category-suggestion').forEach(function (item) {
                    item.classList.remove('selected');
                });
                button.classList.add('selected');
                categoryInput.focus();
            });
        });

        // Código de barras: cámara del celular (Chrome en Android) con el detector del navegador.
        (function () {
            var input = document.querySelector('.ml-gtin');
            if (!input) return;
            var button = document.querySelector('.ml-gtin-scan');
            var video = document.querySelector('.ml-gtin-camera');
            var reason = document.querySelector('[data-attr-id="EMPTY_GTIN_REASON"] select');
            input.addEventListener('input', function () {
                if (input.value.trim() && reason) { reason.value = ''; reason.dispatchEvent(new Event('change')); }
            });
            if (!('BarcodeDetector' in window) || !navigator.mediaDevices) return;
            var stream = null;
            function stop() {
                if (stream) stream.getTracks().forEach(function (t) { t.stop(); });
                stream = null; video.hidden = true; button.textContent = 'Escanear';
            }
            button.hidden = false;
            button.addEventListener('click', function () {
                if (stream) { stop(); return; }
                var detector = new BarcodeDetector({ formats: ['ean_13', 'upc_a', 'upc_e', 'ean_8', 'itf'] });
                navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(function (s) {
                    stream = s; video.srcObject = s; video.hidden = false; video.play(); button.textContent = 'Cerrar cámara';
                    (function tick() {
                        if (!stream) return;
                        detector.detect(video).then(function (codes) {
                            if (codes.length) {
                                input.value = codes[0].rawValue;
                                input.dispatchEvent(new Event('input'));
                                if (window.msToast) window.msToast('success', 'Código leído: ' + codes[0].rawValue);
                                stop();
                                return;
                            }
                            requestAnimationFrame(tick);
                        }).catch(function () { requestAnimationFrame(tick); });
                    })();
                }).catch(function () {
                    if (window.msToast) window.msToast('error', 'No me dieron permiso para usar la cámara.');
                });
            });
        })();

        document.querySelectorAll('.ml-attribute-select').forEach(function (select) {
            select.addEventListener('change', function () {
                var target = document.getElementById(select.dataset.valueNameTarget);
                var selected = select.options[select.selectedIndex];
                if (target) {
                    target.value = selected ? (selected.dataset.valueName || '') : '';
                }
            });
        });

        (function () {
            var button = document.getElementById('calculate-profitability');
            if (!button) return;

            function numberValue(id) {
                var element = document.getElementById(id);
                var value = element ? Number.parseFloat(element.value) : 0;
                return Number.isFinite(value) ? value : 0;
            }

            function money(value, currency) {
                return new Intl.NumberFormat('es-MX', {
                    style: 'currency',
                    currency: currency || 'MXN'
                }).format(value);
            }

            button.addEventListener('click', async function () {
                var error = document.getElementById('profitability-error');
                var loading = document.getElementById('profitability-loading');
                var result = document.getElementById('profitability-result');
                var account = document.getElementById('MarketplaceAccountId');
                var category = document.getElementById('CategoryId');
                var listingType = document.getElementById('ListingTypeId');
                var currency = document.getElementById('CurrencyId');
                var price = numberValue('Price');
                var unitCost = numberValue('UnitCost');

                error.textContent = '';
                result.classList.add('d-none');
                if (!account || !account.value || !category || !category.value || price <= 0 || unitCost <= 0) {
                    error.textContent = 'Completa cuenta, categoría, precio de venta y costo del producto.';
                    return;
                }

                loading.classList.remove('d-none');
                button.disabled = true;
                try {
                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var body = new URLSearchParams({
                        __RequestVerificationToken: token,
                        MarketplaceAccountId: account.value,
                        CategoryId: category.value,
                        Price: price.toString(),
                        CurrencyId: currency.value,
                        ListingTypeId: listingType.value
                    });
                    var response = await fetch('@Url.Action("EstimateMercadoLibreFees", "Products")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                        body: body.toString()
                    });
                    var payload = await response.json();
                    if (!response.ok) throw new Error(payload.message || 'No fue posible calcular la comisión.');

                    var shipping = numberValue('ShippingCost');
                    var other = numberValue('OtherCosts');
                    var taxRate = numberValue('TaxRate');
                    var taxes = price * taxRate / 100;
                    var profit = price - payload.saleFeeAmount - taxes - unitCost - shipping - other;
                    var margin = price > 0 ? profit / price * 100 : 0;
                    var variableRate = (payload.percentageFee + taxRate) / 100;
                    var breakEven = variableRate < 1
                        ? (unitCost + shipping + other + payload.fixedFee) / (1 - variableRate)
                        : 0;
                    var status = document.getElementById('profitability-status');

                    document.getElementById('profitability-fee').textContent = money(payload.saleFeeAmount, payload.currencyId);
                    document.getElementById('profitability-fee-detail').textContent =
                        payload.percentageFee.toFixed(2) + '% + cargo fijo ' + money(payload.fixedFee, payload.currencyId);
                    document.getElementById('profitability-profit').textContent = money(profit, payload.currencyId);
                    document.getElementById('profitability-margin').textContent = margin.toFixed(2) + '%';
                    document.getElementById('profitability-break-even').textContent =
                        breakEven > 0 ? money(breakEven, payload.currencyId) : 'Revisar costos';

                    status.className = 'profitability-status';
                    if (profit < 0) {
                        status.textContent = 'Publicación con pérdida';
                        status.classList.add('loss');
                    } else if (margin < 10) {
                        status.textContent = 'Margen bajo';
                        status.classList.add('low');
                    } else {
                        status.textContent = 'Rentable';
                        status.classList.add('healthy');
                    }
                    result.classList.remove('d-none');
                } catch (exception) {
                    error.textContent = exception.message;
                } finally {
                    loading.classList.add('d-none');
                    button.disabled = false;
                }
            });
        })();
    </script>
}

<style>
    .publication-readiness { background: var(--denim-soft); border-radius: 999px; color: var(--denim); font-size: .72rem; font-weight: 850; padding: .35rem .6rem; }
    .profitability-card { overflow: hidden; }
    .profitability-estimate-badge { background: var(--warn-soft); border-radius: 999px; color: var(--warn); font-size: .65rem; font-weight: 800; padding: .38rem .62rem; text-transform: none; }
    .profitability-result { background: var(--paper-2); border: 1px solid var(--line); border-radius: 12px; display: grid; gap: 1px; grid-template-columns: repeat(4, minmax(0, 1fr)) auto; overflow: hidden; }
    .profitability-metric { background: var(--surface); min-width: 0; padding: 14px; }
    .profitability-metric span, .profitability-metric small { color: var(--muted); display: block; font-size: .62rem; }
    .profitability-metric strong { color: var(--ink); display: block; font-size: 1rem; font-weight: 850; margin: 4px 0; }
    .profitability-status { align-items: center; background: var(--paper-2); color: var(--muted); display: flex; font-size: .7rem; font-weight: 850; justify-content: center; min-width: 115px; padding: 14px; text-align: center; text-transform: none; }
    .profitability-status.healthy { background: var(--ok-soft); color: var(--ok); } .profitability-status.low { background: var(--warn-soft); color: var(--warn); } .profitability-status.loss { background: var(--bad-soft); color: var(--bad); }
    @@media (max-width: 991px) { .profitability-result { grid-template-columns: repeat(2, minmax(0, 1fr)); } .profitability-status { grid-column: 1 / -1; } }
    .category-suggestion { align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; color: var(--ink-2); display: flex; gap: 10px; padding: 10px 12px; text-align: left; width: 100%; }
    .category-suggestion:hover { background: var(--denim-soft); border-color: var(--denim); }
    .category-suggestion.selected { background: var(--denim-soft); border-color: var(--denim); color: var(--denim); }
    .category-suggestion-check { align-items: center; background: var(--paper-2); border-radius: 50%; color: transparent; display: inline-flex; flex: 0 0 24px; height: 24px; justify-content: center; font-size: .7rem; font-weight: 900; }
    .category-suggestion.selected .category-suggestion-check { background: var(--denim); color: var(--surface); }
    .category-suggestion strong, .category-suggestion small { display: block; }
    .category-suggestion strong { font-size: .78rem; }
    .category-suggestion small { color: var(--muted); font-size: .66rem; margin-top: 2px; }
</style>
