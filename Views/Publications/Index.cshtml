@model MarketplaceSync.Web.ViewModels.Publications.PublicationsIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Publicados";
    var mx = CultureInfo.GetCultureInfo("es-MX");
    string Mxn(decimal? v) => v.HasValue ? v.Value.ToString("C0", mx) : "—";
    var filters = new (string? Key, string Label, int Count)[]
    {
        (null, "Todas", Model.ActiveCount + Model.PausedCount),
        ("loss", "Con pérdida", Model.LossCount),
        ("nocost", "Sin costo", Model.NoCostCount),
        ("mismatch", "Stock diferente", Model.MismatchCount),
        ("paused", "Pausadas", Model.PausedCount)
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="page-title">Publicados</h1>
        <p class="text-muted mb-0">
            Tus publicaciones en Mercado Libre, lo que te deja cada pieza y su stock.
            @if (Model.LastSyncedAt.HasValue)
            {
                <span>Actualizado el @Model.LastSyncedAt.Value.ToLocalTime().ToString("dd/MM HH:mm"); se revisa solo cada 30 minutos.</span>
            }
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.HasConnectedAccount)
        {
            <a asp-controller="Titles" asp-action="Index" class="btn btn-outline-secondary">@Html.Icon("pencil") Revisar títulos</a>
            <a asp-controller="BulkEdit" asp-action="Export" class="btn btn-outline-secondary">@Html.Icon("download") Bajar Excel</a>
            <form asp-controller="BulkEdit" asp-action="Upload" method="post" enctype="multipart/form-data" class="be-upload" data-busy="Leyendo…">
                @Html.AntiForgeryToken()
                <label class="btn btn-outline-secondary mb-0" for="beFile" title="Sube el Excel con «Precio nuevo», «Stock nuevo» o «Estado nuevo»">@Html.Icon("upload") Subir Excel</label>
                <input id="beFile" name="file" type="file" accept=".xlsx,.csv" class="visually-hidden" onchange="this.form.requestSubmit()" />
            </form>
        }
        <form asp-action="Sync" method="post" id="syncForm">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" id="syncButton" @(Model.HasConnectedAccount ? "" : "disabled")>@Html.Icon("refresh-cw") Actualizar desde Mercado Libre</button>
        </form>
    </div>
</div>

@if (!Model.HasConnectedAccount)
{
    <div class="alert alert-warning">
        Conecta tu cuenta en <a asp-controller="MercadoLibre" asp-action="Status" class="alert-link">Cuentas de Mercado Libre</a> para ver tus publicaciones.
    </div>
}

<dl class="stats">
    <div class="stat"><dt>Activas</dt><dd>@Model.ActiveCount</dd></div>
    <div class="stat"><dt>Piezas publicadas</dt><dd>@Model.UnitsListed.ToString("N0", mx)</dd></div>
    <div class="stat @(Model.PotentialProfitMxn < 0 ? "is-bad" : Model.PotentialProfitMxn > 0 ? "is-ok" : "")"><dt>Ganancia si vendes todo</dt><dd>@Mxn(Model.PotentialProfitMxn)</dd></div>
    <div class="stat @(Model.NoCostCount > 0 ? "is-warn" : "")"><dt>Sin costo registrado</dt><dd>@Model.NoCostCount</dd></div>
</dl>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="pl-chips">
        @foreach (var f in filters)
        {
            if (f.Key is not null && f.Count == 0) continue;
            <a class="pub-chip @(Model.Filter == f.Key ? "active" : "")" asp-action="Index" asp-route-filter="@f.Key" asp-route-q="@Model.Search">@f.Label <span>@f.Count</span></a>
        }
    </div>
    <form method="get" class="d-flex gap-2 pub-search">
        <input type="hidden" name="filter" value="@Model.Filter" />
        <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Buscar título o MLM…" aria-label="Buscar publicaciones" />
    </form>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="today-clear">
        <div>
            <div class="fw-bold">@(Model.ActiveCount + Model.PausedCount == 0 ? "Todavía no hay publicaciones" : "Nada con este filtro")</div>
            <div class="text-muted small">
                @(Model.ActiveCount + Model.PausedCount == 0
                    ? "Presiona “Sincronizar con Mercado Libre” para traer las que ya tienes, o publica un producto desde Productos."
                    : "Prueba con otro filtro.")
            </div>
        </div>
    </div>
}
else
{
    <div class="pub-list">
        <div class="pub-row pub-head">
            <div></div>
            <div>Publicación</div>
            <div class="text-end">Precio</div>
            <div class="text-end">Te cuesta</div>
            <div class="text-end">Ganas por pieza</div>
            <div class="text-center">Stock</div>
            <div class="text-center">Vendidos</div>
        </div>

        @foreach (var r in Model.Rows)
        {
            var profit = r.Profit;
            <div class="pub-row @(r.Status != "active" ? "is-paused" : "")">
                <div class="pub-pick">
                    <input type="checkbox" class="form-check-input pub-select" name="ids" value="@r.PublicationId" form="bulkForm" aria-label="Seleccionar @r.Title" />
                    <span class="recent-thumb pub-thumb">
                        @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                        {
                            <img src="@r.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />
                        }
                    </span>
                </div>

                <div class="min-w-0">
                    <a asp-action="Edit" asp-route-id="@r.PublicationId" class="pl-title" title="Editar @r.Title">@r.Title</a>
                    <div class="pl-meta">
                        <span>@r.ItemId</span>
                        <span><a asp-controller="Products" asp-action="Details" asp-route-id="@r.ProductId">Producto</a></span>
                        @if (r.Status != "active") { <span class="text-danger">@(r.Status == "paused" ? "Pausada" : r.Status)</span> }
                        @if (r.CatalogStatus is { } cat) { <span><a asp-controller="Quality" asp-action="Index" asp-fragment="catalogo" class="pill @MarketplaceSync.Services.MercadoLibre.CatalogCompetitionService.StatusTone(cat)">Catálogo: @MarketplaceSync.Services.MercadoLibre.CatalogCompetitionService.StatusLabel(cat).ToLowerInvariant()</a></span> }
                        @if (r.AutoPriceStatus is { } aps) { <span><a asp-action="Edit" asp-route-id="@r.PublicationId" asp-fragment="pe-auto-panel" class="pill @(aps == "ACTIVE" ? "pill-info" : "pill-warn")" title="Mercado Libre mueve el precio para competir">Precio automático@(aps == "ACTIVE" ? "" : " en pausa")</a></span> }
                        @if (r.RatingAverage is { } ra && r.RatingCount is > 0) { <span><a asp-controller="Quality" asp-action="Index" asp-fragment="opiniones" class="pill @(ra < 4 ? "pill-bad" : ra < 4.5m ? "pill-warn" : "pill-ok")" title="Opiniones de compradores">★ @ra.ToString("0.0", mx) (@r.RatingCount)</a></span> }
                        @if (r.QualityScore is { } qs) { <span><a asp-controller="Quality" asp-action="Index" asp-fragment="calidad" class="pill @MarketplaceSync.Services.MercadoLibre.ListingQualityService.LevelTone(r.QualityLevel)" title="Calidad según Mercado Libre">Calidad @qs</a></span> }
                        @if (!string.IsNullOrWhiteSpace(r.Permalink)) { <span><a href="@r.Permalink" target="_blank" rel="noopener noreferrer">Ver en Mercado Libre @Html.Icon("external-link", "icon-xs")</a></span> }
                    </div>
                    <a asp-action="Edit" asp-route-id="@r.PublicationId" class="btn btn-outline-secondary btn-sm pub-edit-btn">@Html.Icon("pencil") Editar</a>
                    @if (r.Kit is { } kit)
                    {
                        <div class="pub-kit @(kit.KitIsBetter ? "is-better" : "")">
                            Bajo $299: Mercado Libre cobra cargo fijo. Sola gana @Mxn(kit.UnitProfitMxn)/pza;
                            en kit de @kit.Quantity a @Mxn(kit.KitPriceMxn) ganaría @Mxn(kit.KitProfitPerUnitMxn)/pza
                            @(kit.KitIsBetter ? "— conviene el kit." : "— conviene venderla sola.")
                        </div>
                    }
                </div>

                <div class="text-end" data-label="Precio">
                    <div class="pl-value">@Mxn(r.Price)</div>
                    @if (profit != null)
                    {
                        <div class="pl-sub" title="Comisión @(r.FeeIsReal ? "real de Mercado Libre" : "estimada con tu porcentaje")">comisión @Mxn(profit.MarketplaceFeeMxn)@(r.FeeIsReal ? "" : "*")</div>
                    }
                </div>

                <div class="text-end" data-label="Te cuesta">
                    @if (r.CostKnown)
                    {
                        <div class="pl-value">@Mxn(r.LandedCostMxn)</div>
                        <div class="pl-sub">@(r.CostIsReal ? "real del viaje" : r.CostCurrency == "MXN" ? "en Juárez" : $"US${r.CostValue:0.00} + cruce")</div>
                    }
                    else
                    {
                        <form asp-action="SetCost" method="post" class="pub-cost-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@r.ProductId" />
                            <input type="hidden" name="filter" value="@Model.Filter" />
                            <div class="pub-cost-input">
                                <input type="text" inputmode="decimal" name="cost" class="form-control" placeholder="38.50" aria-label="Costo por pieza de @r.Title" required />
                                <select name="currency" class="form-select" aria-label="Moneda del costo">
                                    <option value="USD">USD</option>
                                    <option value="MXN">MXN</option>
                                </select>
                                <button class="btn btn-outline-secondary" type="submit">Guardar</button>
                            </div>
                        </form>
                    }
                </div>

                <div class="text-end" data-label="Ganas por pieza">
                    @if (profit != null)
                    {
                        <div class="pl-value @(profit.NetProfitMxn < 0 ? "text-danger" : profit.IsProfitable ? "text-success" : "")">@Mxn(profit.NetProfitMxn)</div>
                        <div class="pl-sub">margen @profit.NetMarginPercent.ToString("0.#", mx)%</div>
                        @if (r.SuggestedPriceMxn is { } suggestedPrice)
                        {
                            <form method="post" asp-action="Bulk" class="pl-suggest"
                                  data-confirm="Cambiar el precio en Mercado Libre de @Mxn(r.Price) a @Mxn(suggestedPrice)?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ids" value="@r.PublicationId" />
                                <input type="hidden" name="bulkAction" value="suggested" />
                                <input type="hidden" name="filter" value="@Model.Filter" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Precio para ganar lo que pide Costos de cruce">
                                    Subir a @Mxn(suggestedPrice)
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="pl-sub">Agrega el costo</div>
                    }
                </div>

                <div class="text-center" data-label="Stock">
                    <div class="pl-value">@(r.MercadoLibreStock?.ToString() ?? "—")</div>
                    @if (r.AppStock.HasValue)
                    {
                        if (r.StockMismatch)
                        {
                            <div class="pl-sub text-warning" title="@(r.LastStockPushError ?? "Se corregirá en la próxima sincronización")">inventario: @r.AppStock</div>
                        }
                        else
                        {
                            <div class="pl-sub text-success">sincronizado</div>
                        }
                    }
                    else if (!r.HasRemoteVariations)
                    {
                        <form asp-action="ManageStock" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="publicationId" value="@r.PublicationId" />
                            <button type="submit" class="btn btn-link btn-sm p-0 pub-manage" title="Crea un SKU con este stock y lo sincroniza desde Inventario">Controlar desde la app</button>
                        </form>
                    }
                </div>

                <div class="text-center pl-value" data-label="Vendidos">@(r.Sold?.ToString("N0", mx) ?? "—")</div>
            </div>
        }
    </div>
    <form asp-action="Bulk" method="post" id="bulkForm" class="pub-bulk" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="filter" value="@Model.Filter" />
        <strong id="bulkCount">0 seleccionadas</strong>
        <select name="bulkAction" id="bulkAction" class="form-select form-select-sm" aria-label="Qué hacer">
            <option value="price">Cambiar precio</option>
            <option value="suggested">Precio sugerido (solo las que no ganan lo mínimo)</option>
            <option value="autoprice">Precio automático (sin bajar de tu mínimo)</option>
            <option value="discount">Poner descuento</option>
            <option value="undiscount">Quitar descuento o promoción</option>
            <option value="paused">Pausar</option>
            <option value="active">Activar</option>
        </select>
        <span class="d-inline-flex gap-1" id="bulkPrice">
            <input name="amount" class="form-control form-control-sm" style="width: 90px" inputmode="decimal" placeholder="5 o -100" aria-label="Cuánto cambiar el precio" />
            <select name="mode" class="form-select form-select-sm" aria-label="Porcentaje o pesos">
                <option value="percent">%</option>
                <option value="amount">pesos</option>
            </select>
        </span>
        <span class="d-inline-flex gap-1 align-items-center" id="bulkDiscount" hidden>
            <select name="percent" class="form-select form-select-sm" aria-label="Descuento">
                @foreach (var pct in new[] { 5, 10, 15, 20, 25, 30, 40, 50 }) { <option value="@pct" selected="@(pct == 10)">@pct%</option> }
            </select>
            <select name="days" class="form-select form-select-sm" aria-label="Cuántos días">
                <option value="3">3 días</option><option value="7" selected>7 días</option><option value="15">15 días</option><option value="31">31 días</option>
            </select>
            <label class="small text-white text-nowrap"><input type="checkbox" class="form-check-input me-1" name="includeLosing" value="true" />también las que pierden</label>
        </span>
        <button type="submit" class="btn btn-primary btn-sm" id="bulkButton">Aplicar en Mercado Libre</button>
        <button type="button" class="btn btn-link btn-sm text-white" id="bulkClear">Quitar selección</button>
    </form>
    <p class="small text-muted mt-2">* Comisión estimada con tu porcentaje de Costos de cruce; la real se carga al sincronizar. La ganancia descuenta envío, comisión y retenciones.</p>
}

@section Scripts {
    <script>
        (function () {
            var bar = document.getElementById('bulkForm');
            if (!bar) return;
            var boxes = Array.from(document.querySelectorAll('.pub-select'));
            var count = document.getElementById('bulkCount');
            function refresh() {
                var n = boxes.filter(function (b) { return b.checked; }).length;
                bar.hidden = n === 0;
                count.textContent = n + (n === 1 ? ' seleccionada' : ' seleccionadas');
            }
            boxes.forEach(function (b) { b.addEventListener('change', refresh); });
            document.getElementById('bulkClear').addEventListener('click', function () { boxes.forEach(function (b) { b.checked = false; }); refresh(); });
            var action = document.getElementById('bulkAction'), price = document.getElementById('bulkPrice');
            var discount = document.getElementById('bulkDiscount');
            action.addEventListener('change', function () { price.hidden = action.value !== 'price'; discount.hidden = action.value !== 'discount'; });
            document.querySelectorAll('form[data-confirm]').forEach(function (f) {
                f.addEventListener('submit', function (e) {
                    if (!confirm(f.dataset.confirm)) { e.preventDefault(); return; }
                    var b = f.querySelector('button'); setTimeout(function () { b.disabled = true; b.textContent = 'Cambiando…'; }, 0);
                });
            });
            bar.addEventListener('submit', function () {
                var b = document.getElementById('bulkButton'); setTimeout(function () { b.disabled = true; b.textContent = 'Aplicando…'; }, 0);
            });
        })();
        document.getElementById('syncForm')?.addEventListener('submit', function () {
            var b = document.getElementById('syncButton'); setTimeout(function () { b.disabled = true; b.textContent = 'Actualizando…'; }, 0);
        });
    </script>
}
