@model ErrorViewModel
@{
    ViewData["Title"] = "Algo falló";
}

<div class="panel" style="max-width: 760px">
    <div class="panel-head">
        <h1 class="h4 mb-1">Algo falló en esta pantalla</h1>
        <p class="mb-0">No se guardó nada a medias. Puedes volver atrás e intentarlo de nuevo.</p>
    </div>
    <div class="panel-body">
        @if (!string.IsNullOrWhiteSpace(Model.Detail))
        {
            <p class="mb-2">Si se repite, copia este recuadro y mándalo para corregirlo:</p>
            <pre class="small text-wrap p-3 rounded" style="background: var(--surface-2, #f4f5f8); user-select: all;">Pantalla: @Model.Path
Error: @Model.Detail
@if (!string.IsNullOrWhiteSpace(Model.Where))
{
@:Dónde: @Model.Where
}
ID: @Model.RequestId</pre>
        }
        else if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-0">ID del error: <code>@Model.RequestId</code></p>
        }
        <a href="javascript:history.back()" class="btn btn-outline-secondary mt-2">Volver</a>
    </div>
</div>
