@*
    Mensajes de confirmación/error después de una acción (TempData).
    El layout lo muestra en todas las pantallas; una vista que dibuja sus propios avisos
    marca Context.Items["FlashRendered"] = true para no duplicarlos.
*@
@{
    var success = TempData["Success"] as string ?? TempData["SuccessMessage"] as string;
    var warning = TempData["Warning"] as string;
    var error = TempData["Error"] as string;
}

@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 alert-dismissible fade show" role="status">
        <span aria-hidden="true">✓</span>
        <div>@success</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(warning))
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 alert-dismissible fade show" role="status">
        <span aria-hidden="true">!</span>
        <div>@warning</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-start gap-2 alert-dismissible fade show" role="alert">
        <span aria-hidden="true">✕</span>
        <div>@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
