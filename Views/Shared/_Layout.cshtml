<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MarketplaceSync</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --ms-primary: #0d6efd;
            --ms-dark: #20242a;
            --ms-muted: #6c757d;
            --ms-bg: #f6f8fb;
            --ms-card: #ffffff;
            --ms-border: #e5e7eb;
            --ms-success: #198754;
            --ms-warning: #ffc107;
            --ms-danger: #dc3545;
        }

        html, body {
            height: 100%;
        }

        body {
            background: var(--ms-bg);
            color: var(--ms-dark);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .app-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-navbar {
            background: #ffffff;
            border-bottom: 1px solid var(--ms-border);
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        }

        .brand-mark {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--ms-dark);
            text-decoration: none;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d6efd, #20c997);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
        }

        .nav-link {
            font-weight: 600;
            color: #4b5563 !important;
            border-radius: 10px;
            padding: 8px 12px !important;
        }

        .nav-link:hover {
            background: #f1f5f9;
            color: #111827 !important;
        }

        .nav-link.active-link {
            background: #e7f1ff;
            color: #0d6efd !important;
        }

        .main-content {
            flex: 1;
            padding-top: 32px;
            padding-bottom: 48px;
        }

        .page-container {
            max-width: 1500px;
            margin: 0 auto;
            padding-left: 24px;
            padding-right: 24px;
        }

        .footer {
            background: #ffffff;
            border-top: 1px solid var(--ms-border);
            padding: 18px 0;
            color: var(--ms-muted);
            font-size: 14px;
        }

        .btn {
            border-radius: 10px;
            font-weight: 600;
        }

        .card {
            border-radius: 18px;
            border: 1px solid var(--ms-border);
        }

        .badge {
            border-radius: 8px;
            padding: 6px 9px;
        }

        .table {
            vertical-align: middle;
        }

        .table thead th {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #64748b;
            font-weight: 800;
            border-bottom: 1px solid var(--ms-border);
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            min-height: 44px;
        }

        .form-label {
            font-weight: 700;
            color: #374151;
        }

        .alert {
            border-radius: 14px;
        }

        @@media (max-width: 768px) {
            .page-container {
                padding-left: 16px;
                padding-right: 16px;
            }

            .main-content {
                padding-top: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="app-shell">

        <header class="top-navbar sticky-top">
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container-fluid page-container">

                    <a class="brand-mark" asp-controller="Home" asp-action="Index">
                        <span class="brand-icon">M</span>
                        <span>MarketplaceSync</span>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir navegación">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1 mt-3 mt-lg-0">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Inicio
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Products"
                                   asp-action="Index">
                                    Productos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Products"
                                   asp-action="CreateFromUrl">
                                    Agregar por link
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="MercadoLibre"
                                   asp-action="Status">
                                    Mercado Libre
                                </a>
                            </li>

                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main class="main-content">
            <div class="page-container">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>

        <footer class="footer">
            <div class="page-container d-flex flex-wrap justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year - MarketplaceSync</span>
                <span class="text-muted">Automatización de productos, stock y publicación.</span>
            </div>
        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>