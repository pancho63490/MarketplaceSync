@inject MarketplaceSync.Services.Navigation.NavBadgeService NavBadgeService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var badges = isAuthenticated ? await NavBadgeService.GetAsync(Context.RequestAborted) : new MarketplaceSync.Services.Navigation.NavBadges(0, 0, 0);
    int BadgeFor(string controller) => controller switch
    {
        "Questions" => badges.PendingQuestions,
        "Orders" => badges.OrdersToShip,
        "PostSale" => badges.PostSale,
        _ => 0
    };
    string BadgeTitle(string controller) => controller switch
    {
        "Questions" => badges.PendingQuestions == 1 ? "1 pregunta sin responder" : $"{badges.PendingQuestions} preguntas sin responder",
        "PostSale" => (badges.OpenClaims > 0 ? $"{badges.OpenClaims} reclamo(s) abierto(s), " : "") + $"{badges.PostSale - badges.OpenClaims} mensaje(s) sin responder",
        "Orders" => (badges.OrdersToShip == 1 ? "1 pedido por enviar" : $"{badges.OrdersToShip} pedidos por enviar") + (badges.LateOrders > 0 ? $", {badges.LateOrders} atrasado(s)" : ""),
        _ => ""
    };
    var userName = User.Identity?.Name ?? "";
    var userInitial = string.IsNullOrEmpty(userName) ? "?" : userName[..1].ToUpperInvariant();

    // Menú único: la barra lateral y el menú de celular se generan de esta misma lista.
    // (Controller, Action, Icono, Texto)
    var menu = isAuthenticated
        ? new (string Title, (string Controller, string Action, string Icon, string Label)[] Items)[]
        {
            ("", new[]
            {
                ("Home", "Index", "house", "Hoy")
            }),
            ("Vender", new[]
            {
                ("Orders", "Index", "receipt", "Pedidos"),
                ("Questions", "Index", "message-circle-question", "Preguntas"),
                ("PostSale", "Index", "message-circle", "Postventa"),
                ("Products", "Index", "package", "Productos"),
                ("Publications", "Index", "store", "Publicados"),
                ("Promotions", "Index", "badge-percent", "Promociones"),
                ("Ads", "Index", "megaphone", "Publicidad"),
                ("Quality", "Index", "gauge", "Calidad y catálogo"),
                ("Photos", "Index", "image", "Fotos"),
                ("Inventory", "Index", "boxes", "Inventario"),
                ("Metrics", "Index", "chart-column", "Métricas"),
                ("Finance", "Index", "circle-dollar-sign", "Gastos y ganancia"),
                ("Invoices", "Index", "receipt", "Facturas"),
                ("Money", "Index", "badge-dollar-sign", "Dinero")
            }),
            ("Comprar en EE.UU.", new[]
            {
                ("Trips", "Index", "truck", "Viajes y paquetes"),
                ("Purchasing", "Index", "shopping-cart", "Qué comprar"),
                ("WatchedCategories", "Index", "radar", "Categorías a vigilar"),
                ("Agent", "Index", "bot", "Agente de importación"),
                ("Competitors", "Index", "store", "Competencia"),
                ("MarketInsights", "Index", "trending-up", "Más vendidos MX"),
                ("CrossBorder", "Index", "calculator", "Costos de cruce")
            }),
            ("Configuración", new[]
            {
                ("MercadoLibre", "Status", "link", "Cuentas de Mercado Libre"),
                ("Notifications", "Index", "bell", "Avisos por Telegram"),
                ("Automation", "Index", "bot", "Automático")
            })
        }
        : new (string Title, (string Controller, string Action, string Icon, string Label)[] Items)[]
        {
            ("Acceso", new[]
            {
                ("Account", "Login", "arrow-right", "Iniciar sesión"),
                ("Account", "Register", "plus", "Crear cuenta")
            })
        };

    string IsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
            return "";

        // Dentro de un módulo todas sus pantallas marcan el mismo elemento (ej. Productos > Editar).
        // Solo Account distingue por acción porque Login y Registro son elementos distintos.
        if (action != null &&
            string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            return "";

        return "active";
    }
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f7f9" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · MarketplaceSync</title>
    <script>
        // Tema antes de pintar (sin parpadeo): lo guardado o el del sistema.
        (function () {
            var t = null;
            try { t = localStorage.getItem('ms-theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>

    <link rel="preload" href="~/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/notyf/notyf.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketplaceSync.Web.styles.css" asp-append-version="true" />
</head>

<body>
@{
    async Task RenderNav()
    {
        await Task.CompletedTask;
        foreach (var menuSection in menu)
        {
            <nav class="nav-group" aria-label="@(string.IsNullOrEmpty(menuSection.Title) ? "Inicio" : menuSection.Title)">
                @if (!string.IsNullOrEmpty(menuSection.Title))
                {
                    <div class="nav-group-title">@menuSection.Title</div>
                }
                @foreach (var item in menuSection.Items)
                {
                    var active = IsActive(item.Controller, item.Action);
                    <a class="nav-item-link @active"
                       asp-controller="@item.Controller"
                       asp-action="@item.Action"
                       aria-current="@(active == "active" ? "page" : null)">
                        <span class="nav-icon">@Html.Icon(item.Icon)</span>
                        <span>@item.Label</span>
                        @if (BadgeFor(item.Controller) is > 0 and var count)
                        {
                            <span class="nav-badge @(item.Controller == "Orders" && badges.LateOrders > 0 || item.Controller == "PostSale" && badges.OpenClaims > 0 ? "is-bad" : "")" title="@BadgeTitle(item.Controller)">@(count > 99 ? "99+" : count.ToString())<span class="visually-hidden"> — @BadgeTitle(item.Controller)</span></span>
                        }
                    </a>
                }
            </nav>
        }
    }

    async Task RenderAccount()
    {
        await Task.CompletedTask;
        if (!isAuthenticated)
            return;

        <div class="sidebar-account">
            <div class="account-avatar" aria-hidden="true">@userInitial</div>
            <div class="min-w-0 flex-grow-1">
                <div class="account-name" title="@userName">@userName</div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="account-logout">@Html.Icon("log-out", "icon-xs") Cerrar sesión</button>
                </form>
            </div>
        </div>
    }
}

@if (!isAuthenticated)
{
    // Acceso (iniciar sesión / crear cuenta): sin menú, la pantalla es solo el formulario.
    <main class="auth-shell" id="contenido">
        @{ var authBody = RenderBody(); }
        @if (Context.Items["FlashRendered"] is not true)
        {
            <div class="auth-flash"><partial name="_Flash" /></div>
        }
        @authBody
    </main>
}
else
{
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">MS</span>
            <span class="brand-name">MarketplaceSync<span class="brand-tag">De El Paso a Mercado Libre</span></span>
        </a>

        @if (isAuthenticated)
        {
            <a asp-controller="Products" asp-action="CreateFromUrl" class="btn btn-primary sidebar-cta">@Html.Icon("plus") Importar producto</a>
        }

        @{ await RenderNav(); }
        @{ await RenderAccount(); }
    </aside>

    <div class="app-main">
        <header class="topbar">
            <button type="button" class="topbar-search" data-cmdk-open aria-label="Buscar pantallas, productos o pedidos (Ctrl+K)">
                @Html.Icon("search")<span>Buscar productos, pedidos o pantallas…</span><kbd class="kbd">Ctrl K</kbd>
            </button>
            <div class="topbar-actions">
                <a class="icon-btn" asp-controller="Home" asp-action="Index" title="Pendientes de hoy" aria-label="Pendientes de hoy">
                    @Html.Icon("bell")
                    @if (badges.OpenClaims + badges.LateOrders + badges.PendingQuestions > 0) { <span class="dot" aria-hidden="true"></span> }
                </a>
                <button type="button" class="icon-btn" data-theme-toggle title="Cambiar a modo oscuro o claro" aria-label="Cambiar tema claro u oscuro">
                    <span class="theme-icon-light">@Html.Icon("moon")</span><span class="theme-icon-dark">@Html.Icon("sun")</span>
                </button>
                <span class="account-avatar" title="@userName" aria-hidden="true">@userInitial</span>
            </div>
        </header>

        <header class="mobile-bar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">MS</span>
                <span class="brand-name">MarketplaceSync</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="icon-btn" data-cmdk-open aria-label="Buscar">@Html.Icon("search")</button>
                <button type="button" class="icon-btn" data-theme-toggle aria-label="Cambiar tema claro u oscuro">
                    <span class="theme-icon-light">@Html.Icon("moon")</span><span class="theme-icon-dark">@Html.Icon("sun")</span>
                </button>
                @if (isAuthenticated)
                {
                    <a asp-controller="Products" asp-action="CreateFromUrl" class="btn btn-primary btn-sm" aria-label="Importar producto">@Html.Icon("plus") Importar</a>
                }
                <button class="mobile-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileDrawer" aria-controls="mobileDrawer" aria-label="Abrir menú">@Html.Icon("menu")</button>
            </div>
        </header>

        <div class="offcanvas offcanvas-start mobile-drawer" tabindex="-1" id="mobileDrawer" aria-labelledby="mobileDrawerTitle">
            <div class="offcanvas-header">
                <span class="brand-name" id="mobileDrawerTitle">MarketplaceSync</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar menú"></button>
            </div>
            <div class="offcanvas-body">
                @{ await RenderNav(); }
                @{ await RenderAccount(); }
            </div>
        </div>

        <main class="content-wrap" id="contenido">
            @{
                // El cuerpo se dibuja antes que el layout: si la vista ya mostró sus avisos, no se repiten.
                var pageBody = RenderBody();
            }
            @if (Context.Items["FlashRendered"] is not true)
            {
                <partial name="_Flash" />
            }
            @pageBody
        </main>

        @* Celular: las 4 tareas de todos los días al alcance del pulgar (Productos queda en Más). *@
        <nav class="tab-bar" aria-label="Accesos rápidos">
            @foreach (var tab in new[] { ("Home", "house", "Hoy"), ("Orders", "receipt", "Pedidos"), ("Questions", "message-circle-question", "Preguntas"), ("Purchasing", "shopping-cart", "Comprar") })
            {
                var activeTab = IsActive(tab.Item1);
                <a asp-controller="@tab.Item1" asp-action="Index" class="tab-bar-item @activeTab" aria-current="@(activeTab == "active" ? "page" : null)">
                    <span class="tab-bar-icon">
                        @Html.Icon(tab.Item2)
                        @if (BadgeFor(tab.Item1) is > 0 and var tabCount)
                        {
                            <span class="tab-badge @(tab.Item1 == "Orders" && badges.LateOrders > 0 || tab.Item1 == "Questions" ? "is-bad" : "")">@(tabCount > 99 ? "99+" : tabCount.ToString())</span>
                        }
                    </span>
                    <span>@tab.Item3</span>
                    @if (BadgeFor(tab.Item1) is > 0) { <span class="visually-hidden">@BadgeTitle(tab.Item1)</span> }
                </a>
            }
            <button type="button" class="tab-bar-item" data-bs-toggle="offcanvas" data-bs-target="#mobileDrawer" aria-controls="mobileDrawer">
                @Html.Icon("menu")
                <span>Más</span>
            </button>
        </nav>
    </div>
</div>
}

@if (isAuthenticated)
{
    <partial name="_CommandPalette" model="@menu.SelectMany(m => m.Items.Select(i => (m.Title, i.Controller, i.Action, i.Icon, i.Label))).ToList()" />
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/notyf/notyf.min.js"></script>
<script src="~/lib/countup/countUp.umd.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script type="module">
    // Animación automática al agregar o quitar elementos en listas que cambian sin recargar.
    import autoAnimate from '/lib/auto-animate/index.mjs';
    document.querySelectorAll('[data-auto-animate]').forEach(function (el) { autoAnimate(el, { duration: 180 }); });
</script>

@if (isAuthenticated)
{
    <partial name="_Assistant" />
}

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
